;============================================================
; FILE:    VICMDSCH.MAC
; PROJECT: VIEDIT (viedit/)
; MODULE:  find-char (f F t T ; ,), window/word search, fast literal search, %
;------------------------------------------------------------
; Split out of VICMD.MAC -- see DESIGN.md / build_vi.py link order.
;============================================================
        INCLUDE VI.INC
        PUBLIC  VCBIGF, VCBIGN, VCBIGT, VC_COMMA, VC_F, VC_HASH
        PUBLIC  VC_N, VC_PCT, VC_QM, VC_SEMI, VC_SLASH, VC_STAR
        PUBLIC  VC_TT
        EXTRN   BCONIN, FCCHR, FCDIR, FCSAV, FCTYP, GBCSOF
        EXTRN   GBLDHW, GBMVLT, GBMVRT, GBPKLT, GBPKRT, GCLR
        EXTRN   GOTOPOS, LBJ, OUTCHR, PDECC, PDEPTH, PDIR
        EXTRN   PINCC, PKRTF, PSP, RDPCH, SBHLDE, SCANP
        EXTRN   SCBASE, SCGAPB, SCR1E, SCR2E, SCR2S, SCTXE
        EXTRN   SETDRTY, SHITBOT, SHITTOP, SNOTPFX, SRCBUF, SRCDIR
        EXTRN   SRCH0, SRCLEN, STARLEN, STARSAV, STARWP, STATBUF
        EXTRN   STATCLR, STATHOME, STATMSG, SWRAPF, WSTART
        EXTRN   VMODE, REWIND, FILLFWD, BYTABOVE, GBGOAB, CURLN, CURCOL
        CSEG
;============================================================
; f{c} F{c} t{c} T{c} ; , - find a char on the current line.
;   f/F land ON the char; t/T land just before/after it.  FCDIR 1=fwd FFh=bck;
;   FCTYP 0 = f/F, 1 = t/T.  ; repeats, , repeats in the opposite direction.
;============================================================
VC_F:   MVI     A,1
        STA     FCDIR
        XRA     A
        STA     FCTYP
        JMP     FREAD
VCBIGF:
        MVI     A,0FFH
        STA     FCDIR
        XRA     A
        STA     FCTYP
        JMP     FREAD
VC_TT:  MVI     A,1
        STA     FCDIR
        MVI     A,1
        STA     FCTYP
        JMP     FREAD
VCBIGT:
        MVI     A,0FFH
        STA     FCDIR
        MVI     A,1
        STA     FCTYP
FREAD:                          ; read and remember the target char
        CALL    BCONIN
        STA     FCCHR
        JMP     FCEXE
VC_SEMI:                        ; repeat last f/F/t/T as-is
        JMP     FCEXE
VC_COMMA:                       ; repeat in the opposite direction (one-shot)
        CALL    FLIPDIR
        CALL    FCEXE
        JMP     FLIPDIR

FLIPDIR:
        LDA     FCDIR
        CPI     1
        JNZ     FD_F
        MVI     A,0FFH
        STA     FCDIR
        RET
FD_F:   MVI     A,1
        STA     FCDIR
        RET

FCEXE:
        CALL    GBCSOF          ; HL = cursor byte offset
        SHLD    FCSAV           ; save for restore on a miss
        LDA     FCDIR
        CPI     1
        JZ      FC_FWD
;--- backward (F / T) ---
FCB_LP:
        CALL    GBPKLT
        CPI     0FFH
        JZ      FC_FAIL         ; start of buffer
        CPI     LF
        JZ      FC_FAIL         ; reached start of line
        CALL    GBMVLT
        CALL    GBPKRT          ; char now under the cursor
        MOV     B,A
        LDA     FCCHR
        CMP     B
        JNZ     FCB_LP
        ; hit
        LDA     FCTYP
        ORA     A
        JZ      FC_DONE         ; F: land on the char
        CALL    GBMVRT          ; T: land just after it
        JMP     FC_DONE
;--- forward (f / t) ---
FC_FWD:
FCF_LP:
        CALL    PKRTF           ; A = byte right of cursor; Z if EOF
        JZ      FC_FAIL
        CPI     LF
        JZ      FC_FAIL
        CPI     CR
        JZ      FC_FAIL
        CALL    GBMVRT
        CALL    GBPKRT          ; char now under the cursor
        CPI     0FFH
        JZ      FC_FAIL
        CPI     LF
        JZ      FC_FAIL
        CPI     CR
        JZ      FC_FAIL
        MOV     B,A
        LDA     FCCHR
        CMP     B
        JNZ     FCF_LP
        LDA     FCTYP
        ORA     A
        JZ      FC_DONE         ; f: land on the char
        CALL    GBMVLT          ; t: land just before it
FC_DONE:
        JMP     GCLR
FC_FAIL:
        MVI     A,BEL
        CALL    OUTCHR
        LHLD    FCSAV
        CALL    GOTOPOS         ; cursor unchanged on a miss
        RET

;============================================================
; / ? n N - search the resident window (in-memory) for a literal pattern.
;   SRCDIR 1 = forward, 0FFh = backward.  Wraps once.  Cursor moves to the
;   match start; "Pattern not found" otherwise.  (Whole-file search across the
;   BEFORE/AFTER scratch is a later refinement -- DESIGN section 7.)
;============================================================
VC_SLASH:
        MVI     A,'/'
        CALL    RDPAT
        JC      SRCH_CAN
        MVI     A,1
        STA     SRCDIR
        JMP     DOSRCH
VC_QM:  MVI     A,'?'
        CALL    RDPAT
        JC      SRCH_CAN
        MVI     A,0FFH
        STA     SRCDIR
        JMP     DOSRCH
VC_N:   LDA     SRCLEN
        ORA     A
        RZ                      ; no prior pattern
        JMP     DOSRCH
VCBIGN:
        LDA     SRCLEN
        ORA     A
        RZ
        CALL    FLIPSDIR
        CALL    DOSRCH
        JMP     FLIPSDIR        ; restore the stored direction
SRCH_CAN:
        CALL    STATCLR
        JMP     SETDRTY

FLIPSDIR:
        LDA     SRCDIR
        CPI     1
        JNZ     FSD_F
        MVI     A,0FFH
        STA     SRCDIR
        RET
FSD_F:  MVI     A,1
        STA     SRCDIR
        RET

DOSRCH:
        LDA     SRCLEN
        ORA     A
        RZ                      ; empty pattern -> no-op
        XRA     A
        STA     SWRAPF          ; assume no wrap until a scan crosses the boundary
        CALL    SHOWPAT         ; echo "/pattern" / "?pattern" on the status row
        LDA     VMODE
        ORA     A
        JNZ     VSRCH           ; virtual: cross-boundary cursor-walk search
        LDA     SRCDIR
        CPI     1
        JZ      SRCHFW
        JMP     SRCHBK

;--- SHOWPAT - status row: the prompt char ('/' fwd, '?' bck) + current pattern,
;    shown via STATMSG so it persists for a cycle (this is the live search echo
;    and the post-hit "still showing /pattern" of real vi).  Effective SRCDIR is
;    used, so a reversed N repeat correctly flips '/' <-> '?'.
SHOWPAT:
        LXI     H,STATBUF
        LDA     SRCDIR
        CPI     1
        MVI     A,'/'
        JZ      SP_PC
        MVI     A,'?'
SP_PC:  MOV     M,A
        INX     H
        JMP     APPATZ          ; append SRCBUF[0..SRCLEN), NUL, then STATMSG

;--- APPATZ - HL = dest in STATBUF.  Append the SRCLEN-byte pattern from SRCBUF,
;    terminate with NUL, then show STATBUF on the status row (tail-calls STATMSG).
APPATZ:
        LXI     D,SRCBUF
        LDA     SRCLEN
        MOV     B,A
APZ_LP: MOV     A,B
        ORA     A
        JZ      APZ_E
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JMP     APZ_LP
APZ_E:  MVI     M,NUL
        LXI     D,STATBUF
        JMP     STATMSG

;--- SCOPYZ - copy the NUL-terminated string at DE into HL.  Stops on (does not
;    copy) the NUL; returns HL pointing at the slot where the NUL would go.
SCOPYZ: LDAX    D
        ORA     A
        RZ
        MOV     M,A
        INX     D
        INX     H
        JMP     SCOPYZ

;============================================================
; * / # - search forward / backward for the word under (or after) the cursor.
; The word ([A-Za-z0-9_]) is captured into SRCBUF as a literal pattern (no
; word-boundary anchoring -- our search engine is literal), then the normal
; forward/backward search runs from the word start (so it lands on the NEXT /
; PREVIOUS occurrence, wrapping).
;============================================================
VC_STAR:
        MVI     A,1
        STA     SRCDIR
        JMP     WRDSCH
VC_HASH:
        MVI     A,0FFH
        STA     SRCDIR
WRDSCH:
        CALL    GBCSOF          ; HL = cursor byte offset
        SHLD    STARSAV         ; original cursor (restore if no word found)
WS_SKIP:                        ; advance to the first word char at/after cursor
        CALL    PKRTF           ; A = byte right of cursor; Z if EOF
        JZ      WS_NONE         ; end of buffer, no word
        CALL    ISWORD
        JNZ     WS_FOUND
        CALL    GBMVRT
        JMP     WS_SKIP
WS_FOUND:                       ; step left to the start of the word
        CALL    GBPKLT
        CALL    ISWORD
        JZ      WS_AT0
        CALL    GBMVLT
        JMP     WS_FOUND
WS_AT0:
        CALL    GBCSOF          ; HL = cursor byte offset
        SHLD    WSTART          ; word-start offset (search resumes here)
        LXI     H,SRCBUF
        SHLD    STARWP
        XRA     A
        STA     STARLEN
WS_CAP:                         ; copy the word into SRCBUF (cursor walks to end)
        CALL    GBPKRT
        CALL    ISWORD
        JZ      WS_CAPD
        LDA     STARLEN
        CPI     40
        JNC     WS_CAPNX        ; pattern buffer full -> stop appending, keep walking
        CALL    GBPKRT
        LHLD    STARWP
        MOV     M,A
        INX     H
        SHLD    STARWP
        LDA     STARLEN
        INR     A
        STA     STARLEN
WS_CAPNX:
        CALL    GBMVRT
        JMP     WS_CAP
WS_CAPD:
        LHLD    WSTART
        CALL    GOTOPOS         ; cursor back to the word start
        LDA     STARLEN
        STA     SRCLEN
        JMP     DOSRCH
WS_NONE:
        LHLD    STARSAV
        CALL    GOTOPOS         ; no word -> restore the cursor
        MVI     A,BEL
        JMP     OUTCHR

;--- ISWORD - A = char.  Return A=1 (NZ) if a word char [A-Za-z0-9_], else A=0
;    (Z).  CY clear.  0FFh (EOB) and CR/LF/space classify as non-word.
ISWORD:
        CPI     '0'
        JC      ISW_NO
        CPI     '9'+1
        JC      ISW_YES
        CPI     'A'
        JC      ISW_NO
        CPI     'Z'+1
        JC      ISW_YES
        CPI     '_'
        JZ      ISW_YES
        CPI     'a'
        JC      ISW_NO
        CPI     'z'+1
        JC      ISW_YES
ISW_NO: XRA     A               ; not a word char (Z set)
        RET
ISW_YES:MVI     A,1
        ORA     A               ; set flags (NZ)
        RET

;============================================================
; Fast literal search (physical-pointer scan).  The descriptor fields are
; constant during a search, so SRCHSET caches the two text runs as raw pointers
; ONCE; the scan then walks memory directly (CMP M / INX H) with a cheap
; first-byte gate before the full PMATCH compare -- ~40x the old per-byte
; logical->physical reconversion (LBYTE).  A hit's physical pointer is mapped
; back to a logical offset (PH2LOG) only on success.
;   R1 (before gap): [base,  SCR1E)   logical [0, GAPBG)
;   R2 (at/after):   [SCR2S, SCR2E)   logical [GAPBG, TXEND)
;============================================================
SRCHSET:
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        SHLD    SCBASE
        MVI     A,BD_GAPBG
        CALL    GBLDHW
        SHLD    SCGAPB
        XCHG                    ; DE = GAPBG
        LHLD    SCBASE
        DAD     D               ; base + GAPBG
        SHLD    SCR1E
        MVI     A,BD_GAPEN
        CALL    GBLDHW
        XCHG                    ; DE = GAPEN
        LHLD    SCBASE
        DAD     D               ; base + GAPEN = R2 start
        SHLD    SCR2S
        MVI     A,BD_TXEND
        CALL    GBLDHW
        SHLD    SCTXE
        XCHG                    ; DE = TXEND
        LHLD    SCGAPB
        MOV     A,E
        SUB     L
        MOV     C,A
        MOV     A,D
        SBB     H
        MOV     B,A             ; BC = TXEND - GAPBG = R2 length
        LHLD    SCR2S
        MOV     A,L
        ADD     C
        MOV     L,A
        MOV     A,H
        ADC     B
        MOV     H,A             ; SCR2S + R2len = R2 end
        SHLD    SCR2E
        RET

; LOG2PH - DE = logical offset -> HL = physical pointer.  (BC preserved.)
LOG2PH:
        LHLD    SCGAPB
        MOV     A,E
        SUB     L
        MOV     A,D
        SBB     H
        JNC     L2P_R2          ; L >= GAPBG -> R2
        LHLD    SCBASE
        DAD     D               ; base + L
        RET
L2P_R2:
        LHLD    SCGAPB
        XCHG                    ; HL = L, DE = GAPBG
        CALL    SBHLDE          ; HL = HL - DE
        XCHG                    ; DE = L - GAPBG
        LHLD    SCR2S
        DAD     D               ; SCR2S + (L - GAPBG)
        RET

; PH2LOG - HL = physical pointer -> HL = logical offset.
PH2LOG:
        XCHG                    ; DE = P
        LHLD    SCR1E
        MOV     A,E
        SUB     L
        MOV     A,D
        SBB     H
        JNC     P2L_R2          ; P >= SCR1E -> R2
        LHLD    SCBASE
        XCHG                    ; DE = base, HL = P
        CALL    SBHLDE          ; HL = HL - DE
        RET
P2L_R2:
        LHLD    SCR2S
        XCHG                    ; DE = SCR2S, HL = P
        CALL    SBHLDE          ; HL = HL - DE
        XCHG                    ; DE = P - SCR2S
        LHLD    SCGAPB
        DAD     D               ; GAPBG + (P - SCR2S)
        RET

; PMATCH - compare SRCBUF[0..SRCLEN) against the text starting at physical HL,
; walking the gap (SCR1E -> SCR2S), stopping at SCR2E.  CY clear = match.
PMATCH:
        LDA     SRCLEN
        MOV     B,A             ; remaining
        LXI     D,SRCBUF        ; DE = pattern ptr
PM_LP:
        MOV     A,B
        ORA     A
        JZ      PM_YES
        LDA     SCR2E           ; end of text?
        CMP     L
        JNZ     PM_G
        LDA     SCR2E+1
        CMP     H
        JZ      PM_NO           ; HL == SCR2E -> past end
PM_G:
        LDA     SCR1E           ; gap jump?
        CMP     L
        JNZ     PM_RD
        LDA     SCR1E+1
        CMP     H
        JNZ     PM_RD
        LHLD    SCR2S
PM_RD:
        MOV     C,M             ; text byte
        LDAX    D               ; pattern byte
        CMP     C
        JNZ     PM_NO
        INX     H
        INX     D
        DCR     B
        JMP     PM_LP
PM_YES:
        ORA     A               ; clear CY
        RET
PM_NO:
        STC
        RET

;--- forward search: scan (CSOFF, TXEND) then wrap [0, CSOFF] ---
SRCHFW:
        CALL    SRCHSET
        CALL    GBCSOF          ; HL = cursor byte offset
        SHLD    SRCH0
        XCHG                    ; DE = SRCH0
        LHLD    SCTXE
        MOV     A,L
        SUB     E
        MOV     C,A
        MOV     A,H
        SBB     D
        MOV     B,A             ; BC = TXEND - SRCH0
        MOV     A,B
        ORA     C
        JZ      SFW_WRAP        ; cursor at end -> wrap
        DCX     B               ; count1 = TXEND - SRCH0 - 1
        MOV     A,B
        ORA     C
        JZ      SFW_WRAP
        LHLD    SRCH0
        INX     H
        XCHG                    ; DE = SRCH0+1
        CALL    LOG2PH          ; HL = P
        MOV     D,B
        MOV     E,C             ; DE = count1
SFW1:
        MOV     A,D
        ORA     E
        JZ      SFW_WRAP
        DCX     D
        LDA     SRCBUF
        CMP     M               ; first byte gate
        JNZ     SFW1_NX
        PUSH    D
        PUSH    H
        CALL    PMATCH
        POP     H
        POP     D
        JNC     SFW_HIT
SFW1_NX:
        INX     H
        LDA     SCR1E
        CMP     L
        JNZ     SFW1
        LDA     SCR1E+1
        CMP     H
        JNZ     SFW1
        LHLD    SCR2S           ; gap jump
        JMP     SFW1
SFW_WRAP:
        MVI     A,1
        STA     SWRAPF          ; forward scan ran off the bottom -> wrapping to top
        LHLD    SRCH0
        INX     H
        XCHG                    ; DE = count2 = SRCH0+1
        LHLD    SCBASE          ; P = base (logical 0)
SFW2:
        MOV     A,D
        ORA     E
        JZ      SRCH_MISS
        DCX     D
        LDA     SRCBUF
        CMP     M
        JNZ     SFW2_NX
        PUSH    D
        PUSH    H
        CALL    PMATCH
        POP     H
        POP     D
        JNC     SFW_HIT
SFW2_NX:
        INX     H
        LDA     SCR1E
        CMP     L
        JNZ     SFW2
        LDA     SCR1E+1
        CMP     H
        JNZ     SFW2
        LHLD    SCR2S
        JMP     SFW2
SFW_HIT:
        CALL    PH2LOG
        SHLD    SCANP
        JMP     SRCH_HIT

;--- backward search: scan [0,CSOFF) downward then wrap (CSOFF,TXEND) down ---
SRCHBK:
        CALL    SRCHSET
        CALL    GBCSOF          ; HL = cursor byte offset
        SHLD    SRCH0
        MOV     A,H
        ORA     L
        JZ      SBK_WRAP        ; at offset 0 -> wrap
        XCHG                    ; DE = SRCH0
        MOV     B,D
        MOV     C,E             ; BC = SRCH0 = count1
        DCX     D               ; DE = SRCH0-1
        CALL    LOG2PH          ; HL = P
        MOV     D,B
        MOV     E,C             ; DE = count1
SBK1:
        MOV     A,D
        ORA     E
        JZ      SBK_WRAP
        DCX     D
        LDA     SRCBUF
        CMP     M
        JNZ     SBK1_NX
        PUSH    D
        PUSH    H
        CALL    PMATCH
        POP     H
        POP     D
        JNC     SFW_HIT
SBK1_NX:
        LDA     SCR2S           ; P-- with backward gap jump (SCR2S -> SCR1E)
        CMP     L
        JNZ     SBK1_D
        LDA     SCR2S+1
        CMP     H
        JNZ     SBK1_D
        LHLD    SCR1E
SBK1_D:
        DCX     H
        JMP     SBK1
SBK_WRAP:
        MVI     A,1
        STA     SWRAPF          ; backward scan ran off the top -> wrapping to bottom
        LHLD    SCTXE
        MOV     A,H
        ORA     L
        JZ      SRCH_MISS       ; empty buffer
        XCHG                    ; DE = TXEND
        LHLD    SRCH0
        MOV     A,E
        SUB     L
        MOV     C,A
        MOV     A,D
        SBB     H
        MOV     B,A             ; BC = TXEND - SRCH0
        DCX     B               ; count2 = TXEND - SRCH0 - 1
        MOV     A,B
        ORA     C
        JZ      SRCH_MISS
        LHLD    SCTXE
        DCX     H
        XCHG                    ; DE = TXEND-1
        CALL    LOG2PH          ; HL = P
        MOV     D,B
        MOV     E,C             ; DE = count2
SBK2:
        MOV     A,D
        ORA     E
        JZ      SRCH_MISS
        DCX     D
        LDA     SRCBUF
        CMP     M
        JNZ     SBK2_NX
        PUSH    D
        PUSH    H
        CALL    PMATCH
        POP     H
        POP     D
        JNC     SFW_HIT
SBK2_NX:
        LDA     SCR2S
        CMP     L
        JNZ     SBK2_D
        LDA     SCR2S+1
        CMP     H
        JNZ     SBK2_D
        LHLD    SCR1E
SBK2_D:
        DCX     H
        JMP     SBK2

SRCH_HIT:
        LHLD    SCANP
        CALL    GOTOPOS         ; move cursor to the match; VADJ adjusts the view
        ; No forced full redraw: the main loop's VADJ sees where the cursor
        ; landed and does the cheapest update -- a same-page match is just a
        ; CURPOS, one line off-screen scrolls one row, and only a far jump
        ; raises DIRTY for a full repaint.
SRCH_HM:                        ; virtual search re-entry: cursor is already on the
                                ; match (VSEEK/WFIND positioned it); just message
        LDA     SWRAPF
        ORA     A
        JZ      SH_NOWRAP       ; no wrap -> leave the "/pattern" echo on the row
        LDA     SRCDIR          ; wrapped: report which boundary we crossed
        CPI     1
        LXI     D,SHITBOT       ; forward: hit BOTTOM, continuing at TOP
        JZ      SH_MSG
        LXI     D,SHITTOP       ; backward: hit TOP, continuing at BOTTOM
SH_MSG: JMP     STATMSG
SH_NOWRAP:
        RET                     ; SHOWPAT's echo (STMSGF=1) stays up
SRCH_MISS:
        LXI     H,STATBUF       ; compose "Pattern not found: <pattern>"
        LXI     D,SNOTPFX
        CALL    SCOPYZ
        JMP     APPATZ

;--- LBYTE - HL = logical offset; exit A = byte there, CY clear; CY set if the
;    offset is past the end of the resident text.
LBYTE:
        SHLD    LBJ
        MVI     A,BD_TXEND
        CALL    GBLDHW
        XCHG                    ; DE = TXEND
        LHLD    LBJ
        MOV     A,L
        SUB     E
        MOV     A,H
        SBB     D
        JNC     LB_EOF          ; j >= TXEND
        MVI     A,BD_GAPBG
        CALL    GBLDHW
        XCHG                    ; DE = GAPBG
        LHLD    LBJ
        MOV     A,L
        SUB     E
        MOV     A,H
        SBB     D
        JC      LB_R1           ; j < GAPBG (in R1)
        ; R2: offset = GAPEN + (j - GAPBG)
        LHLD    LBJ
        CALL    SBHLDE          ; HL = HL - DE
        PUSH    H
        MVI     A,BD_GAPEN
        CALL    GBLDHW
        POP     D               ; DE = j - GAPBG
        DAD     D               ; HL = GAPEN + (j-GAPBG)
        JMP     LB_ADDR
LB_R1:
        LHLD    LBJ             ; offset = j
LB_ADDR:
        PUSH    H
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        POP     D               ; DE = offset
        DAD     D               ; HL = base + offset
        MOV     A,M
        ORA     A               ; clear CY
        RET
LB_EOF:
        STC
        RET

;--- RDPAT - read a search pattern into SRCBUF.  Entry A = prompt char.
;    Exit: CY clear = search (SRCLEN/SRCBUF set, or kept from the last search on
;    a bare CR that reuses the previous pattern -- vi's "/<CR>").  CY set =
;    cancel (ESC, BS past the prompt, or a bare CR with no previous pattern).
RDPAT:
        STA     RDPCH
        CALL    STATHOME        ; clear status row, home cursor to it
        LDA     RDPCH
        CALL    OUTCHR
        LXI     H,SRCBUF
        MVI     C,0
RP_LP:
        PUSH    B
        PUSH    H
        CALL    BCONIN
        POP     H
        POP     B
        CPI     CR
        JZ      RP_DONE
        CPI     BS
        JZ      RP_BS
        CPI     DEL
        JZ      RP_BS
        CPI     ESC
        JZ      RP_CAN
        MOV     B,A             ; candidate char
        MOV     A,C
        CPI     40
        JNC     RP_FULL         ; buffer full: bell, ignore
        MOV     A,B
        MOV     M,A
        INX     H
        INR     C
        PUSH    B
        PUSH    H
        CALL    OUTCHR
        POP     H
        POP     B
        JMP     RP_LP
RP_FULL:
        MVI     A,BEL
        CALL    OUTCHR
        JMP     RP_LP
RP_BS:
        MOV     A,C
        ORA     A
        JZ      RP_CAN           ; BS past the prompt cancels the search
        DCX     H
        DCR     C
        PUSH    B               ; OUTCHR clobbers B,C,H,L -- save the count/ptr
        PUSH    H
        MVI     A,BS
        CALL    OUTCHR
        MVI     A,' '
        CALL    OUTCHR
        MVI     A,BS
        CALL    OUTCHR
        POP     H
        POP     B
        JMP     RP_LP
RP_DONE:
        MOV     A,C
        ORA     A
        JZ      RP_REUSE        ; bare CR -> reuse the previous pattern (if any)
        STA     SRCLEN          ; A = C (new pattern length)
        RET                     ; CY clear -> search the freshly typed pattern
RP_REUSE:
        LDA     SRCLEN          ; keep the previous SRCLEN/SRCBUF untouched; with
        ORA     A               ; no prior pattern, cancel so the stray prompt
        JZ      RP_CAN          ; char gets cleared (vi does nothing)
        RET                     ; CY clear (A nonzero) -> search the last pattern
RP_CAN:
        STC
        RET

;============================================================
; % - jump to the matching bracket.  Scans the resident window via LBYTE,
; tracking nesting depth.  ( ) [ ] { }.  BEL if not on a bracket / no match.
;============================================================
VC_PCT:
        CALL    GBPKRT
        CPI     '('
        JZ      P_OP1
        CPI     '['
        JZ      P_OP2
        CPI     '{'
        JZ      P_OP3
        CPI     ')'
        JZ      P_CL1
        CPI     ']'
        JZ      P_CL2
        CPI     '}'
        JZ      P_CL3
        MVI     A,BEL           ; not on a bracket
        JMP     OUTCHR
P_OP1:  MVI     A,'('
        STA     PINCC
        MVI     A,')'
        JMP     P_FWD
P_OP2:  MVI     A,'['
        STA     PINCC
        MVI     A,']'
        JMP     P_FWD
P_OP3:  MVI     A,'{'
        STA     PINCC
        MVI     A,'}'
P_FWD:  STA     PDECC
        MVI     A,1
        STA     PDIR
        JMP     PSCAN
P_CL1:  MVI     A,')'
        STA     PINCC
        MVI     A,'('
        JMP     P_BCK
P_CL2:  MVI     A,']'
        STA     PINCC
        MVI     A,'['
        JMP     P_BCK
P_CL3:  MVI     A,'}'
        STA     PINCC
        MVI     A,'{'
P_BCK:  STA     PDECC
        MVI     A,0FFH
        STA     PDIR
PSCAN:
        LXI     H,1
        SHLD    PDEPTH          ; the bracket under the cursor counts as depth 1
        CALL    GBCSOF          ; HL = cursor byte offset
        SHLD    PSP
PSC_LP:
        LDA     PDIR
        CPI     1
        JZ      PSC_FW
        LHLD    PSP             ; backward
        MOV     A,H
        ORA     L
        JZ      PSC_FAIL
        DCX     H
        SHLD    PSP
        JMP     PSC_CHK
PSC_FW: LHLD    PSP
        INX     H
        SHLD    PSP
PSC_CHK:
        LHLD    PSP
        CALL    LBYTE
        JC      PSC_FAIL
        MOV     B,A
        LDA     PINCC
        CMP     B
        JZ      PSC_INC
        LDA     PDECC
        CMP     B
        JZ      PSC_DEC
        JMP     PSC_LP
PSC_INC:
        LHLD    PDEPTH
        INX     H
        SHLD    PDEPTH
        JMP     PSC_LP
PSC_DEC:
        LHLD    PDEPTH
        DCX     H
        SHLD    PDEPTH
        MOV     A,H
        ORA     L
        JNZ     PSC_LP
        LHLD    PSP             ; depth 0 -> the match
        CALL    GOTOPOS
        JMP     SETDRTY
PSC_FAIL:
        MVI     A,BEL
        JMP     OUTCHR

;============================================================
; Virtual-mode search (cross the window boundary).  The resident window is a
; sliding slice anchored at the cursor, so a whole-document search must WALK the
; cursor through the file, scanning each resident window with the same fast
; literal scanner used in RAM mode (SRCHSET/FSCANL/PMATCH).  WSTEP advances the
; cursor toward the window bottom (keeping SRCLEN-1 bytes of overlap so a match
; straddling the bottom is caught after the next fill) and pages one record in.
;
;   forward (/ , n): WFIND from just after the cursor to EOD -> first match, the
;     cursor lands on it; on miss wrap to the top (GBGOAB 0) and WFIND again.
;   backward (? , N): WCOLL from the top over the whole file, tracking the last
;     match before the origin (PREV) and the last match overall (MAX); target =
;     PREV else MAX (wrap); then WFIND (target mode) from the top lands on it.
;   miss: restore the cursor to the saved origin line+column, "not found".
; Cost is O(document) disk I/O (documented); RAM-only keeps the in-memory scan.
;============================================================
VSRCH:
        ; origin absolute offset ABSCUR = BYTABOVE + CSOFF (cursor byte)
        MVI     A,BD_CSOFF
        CALL    GBLDHW          ; HL = CSOFF (= GAPBG)
        XCHG                    ; DE = CSOFF
        LHLD    BYTABOVE
        DAD     D
        SHLD    ABSCUR
        LDA     BYTABOVE+2
        ACI     0
        STA     ABSCUR+2
        ; save origin line+column for restore-on-miss
        CALL    CURLN
        SHLD    SRSVLN
        CALL    CURCOL
        MOV     A,L
        STA     SRSVCO
        ; overlap = SRCLEN - 1 (guards a match straddling the window bottom)
        LDA     SRCLEN
        DCR     A
        STA     WOVL
        LDA     SRCDIR
        CPI     1
        JNZ     VS_BACK
;--- forward (/ , n): search AFTER the cursor, then wrap ---
        CALL    GBMVRT          ; start after the cursor (vi finds the NEXT match)
        XRA     A
        STA     WTGSET          ; find-first mode
        CALL    WFIND
        JNC     VS_FHIT         ; hit -> cursor is on it, no wrap
        LXI     H,0
        CALL    GBGOAB          ; wrap: cursor to the document top
        XRA     A
        STA     WTGSET
        CALL    WFIND
        JC      VS_MISS
        MVI     A,1             ; wrapped
        STA     SWRAPF
        JMP     SRCH_HM
VS_FHIT:
        XRA     A
        STA     SWRAPF
        JMP     SRCH_HM
;--- backward (? , N): collect PREV/MAX over the whole file, then land ---
VS_BACK:
        XRA     A
        STA     TRKPRVV
        STA     TRKMAXV
        LXI     H,0
        CALL    GBGOAB          ; cursor to the document top
        CALL    WCOLL
        LDA     TRKPRVV
        ORA     A
        JZ      VS_BWRAP
        LXI     H,TRKPRV        ; previous match before the origin
        LXI     D,WTARGET
        CALL    CPY24
        XRA     A
        STA     SWRAPF
        JMP     VS_BLAND
VS_BWRAP:
        LDA     TRKMAXV
        ORA     A
        JZ      VS_MISS         ; no match anywhere
        LXI     H,TRKMAX        ; wrap to the last match in the file
        LXI     D,WTARGET
        CALL    CPY24
        MVI     A,1
        STA     SWRAPF
VS_BLAND:
        LXI     H,0
        CALL    GBGOAB          ; from the top, walk to the target match
        MVI     A,1
        STA     WTGSET          ; find-at-target mode
        CALL    WFIND
        JMP     SRCH_HM
VS_MISS:
        ; restore the cursor to the origin (line, then column) and report
        LHLD    SRSVLN
        CALL    GBGOAB
        LDA     SRSVCO
        ORA     A
        JZ      VS_MISS2
        MOV     B,A
VS_MR:  CALL    GBMVRT
        DCR     B
        JNZ     VS_MR
VS_MISS2:
        JMP     SRCH_MISS

;--- WFIND - walk the cursor from its current position toward EOD; stop on the
;    first match (WTGSET=0), or on the match whose absolute offset == WTARGET
;    (WTGSET=1), leaving the cursor on it (CY clear).  CY set = reached EOD with
;    no (matching) hit.
WFIND:
WF_LP:
        CALL    SRCHSET
        MVI     A,BD_CSOFF
        CALL    GBLDHW          ; HL = CSOFF
        CALL    FSCANL          ; HL = hit logical offset, or CY = none in window
        JC      WF_STEP
        SHLD    WHIT            ; save the hit's logical offset (HL preserved)
        CALL    ABSADD          ; ABSVAL = BYTABOVE + hit
        LDA     WTGSET
        ORA     A
        JZ      WF_HIT          ; find-first -> accept
        LXI     H,ABSVAL
        LXI     D,WTARGET
        CALL    CMP24           ; ABSVAL vs WTARGET
        JZ      WF_HIT          ; the target match -> land
        ; an earlier match: step past it and keep walking
        LHLD    WHIT
        INX     H
        CALL    GOTOPOS
        JMP     WF_LP
WF_HIT:
        LHLD    WHIT
        CALL    GOTOPOS         ; cursor onto the match
        ORA     A               ; clear CY
        RET
WF_STEP:
        CALL    WSTEP
        JNC     WF_LP           ; paged more below -> rescan
        STC                     ; EOD, nothing left to scan
        RET

;--- WCOLL - walk the cursor from its current position (the caller placed it at
;    the top) to EOD, enumerating EVERY match in increasing order, updating
;    TRKMAX (last match overall) and TRKPRV (last match before ABSCUR).
WCOLL:
WC_LP:
        CALL    SRCHSET
        MVI     A,BD_CSOFF
        CALL    GBLDHW
        CALL    FSCANL
        JC      WC_STEP
        SHLD    WHIT
        CALL    ABSADD          ; ABSVAL = BYTABOVE + hit
        LXI     H,ABSVAL        ; TRKMAX = ABSVAL (increasing order -> last = max)
        LXI     D,TRKMAX
        CALL    CPY24
        MVI     A,1
        STA     TRKMAXV
        LXI     H,ABSVAL
        LXI     D,ABSCUR
        CALL    CMP24           ; ABSVAL vs ABSCUR
        JNC     WC_NEXT         ; ABSVAL >= origin -> not a "before-origin" match
        LXI     H,ABSVAL
        LXI     D,TRKPRV
        CALL    CPY24
        MVI     A,1
        STA     TRKPRVV
WC_NEXT:
        LHLD    WHIT
        INX     H
        CALL    GOTOPOS         ; advance past this match
        JMP     WC_LP
WC_STEP:
        CALL    WSTEP
        JNC     WC_LP
        RET                     ; EOD -> sweep complete

;--- WSTEP - advance the cursor toward the window bottom (to TXEND-WOVL, keeping
;    the straddle overlap) then page one record in from below.  CY set = nothing
;    more below (EOD).  Clobbers A,BC,DE,HL.
WSTEP:
        MVI     A,BD_TXEND
        CALL    GBLDHW          ; HL = TXEND
        LDA     WOVL
        MOV     E,A
        MVI     D,0
        MOV     A,L
        SUB     E
        MOV     L,A
        MOV     A,H
        SBI     0
        MOV     H,A             ; HL = TXEND - WOVL = t
        SHLD    WTMP
        MVI     A,BD_CSOFF
        CALL    GBLDHW          ; HL = CSOFF
        XCHG                    ; DE = CSOFF
        LHLD    WTMP            ; HL = t
        MOV     A,L
        SUB     E
        MOV     A,H
        SBB     D               ; t - CSOFF : CY if t < CSOFF
        JC      WS_FILL         ; cursor already within WOVL of the bottom
        JZ      WS_FILL
        LHLD    WTMP
        CALL    GOTOPOS         ; move the cursor forward to t
WS_FILL:
        JMP     FILLFWD         ; CY propagates when nothing is below

;--- FSCANL - first match at/after logical offset HL, scanning to TXEND (no
;    wrap), using the SRCHSET-cached pointers.  Exit: CY clear + HL = match
;    logical offset; CY set = no match in [HL, TXEND).
FSCANL:
        XCHG                    ; DE = logstart
        LHLD    SCTXE           ; HL = TXEND (logical)
        MOV     A,L
        SUB     E
        MOV     C,A
        MOV     A,H
        SBB     D
        MOV     B,A             ; BC = TXEND - logstart
        JC      FSC_NO          ; logstart > TXEND
        MOV     A,B
        ORA     C
        JZ      FSC_NO          ; nothing to scan
        CALL    LOG2PH          ; HL = physical P (DE=logstart consumed; BC kept)
        MOV     D,B
        MOV     E,C             ; DE = count of start positions
FSC_LP:
        MOV     A,D
        ORA     E
        JZ      FSC_NO
        DCX     D
        LDA     SRCBUF
        CMP     M               ; first-byte gate
        JNZ     FSC_NX
        PUSH    D
        PUSH    H
        CALL    PMATCH
        POP     H
        POP     D
        JNC     FSC_HIT
FSC_NX:
        INX     H
        LDA     SCR1E
        CMP     L
        JNZ     FSC_LP
        LDA     SCR1E+1
        CMP     H
        JNZ     FSC_LP
        LHLD    SCR2S           ; gap jump R1 end -> R2 start
        JMP     FSC_LP
FSC_HIT:
        CALL    PH2LOG          ; HL = logical offset of the match
        ORA     A               ; clear CY
        RET
FSC_NO:
        STC
        RET

;--- ABSADD - ABSVAL(3) = BYTABOVE + HL (logical).  Clobbers A,DE,HL.
ABSADD:
        XCHG                    ; DE = logical
        LHLD    BYTABOVE
        DAD     D               ; low16 + logical
        SHLD    ABSVAL
        LDA     BYTABOVE+2
        ACI     0
        STA     ABSVAL+2
        RET

;--- CMP24 - compare 24-bit [HL] vs [DE].  CY set if [HL] < [DE]; Z set if equal;
;    NC & NZ if greater.  Clobbers A,B and advances HL/DE.
CMP24:
        INX     H
        INX     H               ; -> byte 2 (MSB)
        INX     D
        INX     D
        LDAX    D
        MOV     B,A             ; B = b2
        MOV     A,M
        CMP     B               ; a2 - b2
        RNZ
        DCX     H
        DCX     D               ; -> byte 1
        LDAX    D
        MOV     B,A
        MOV     A,M
        CMP     B
        RNZ
        DCX     H
        DCX     D               ; -> byte 0 (LSB)
        LDAX    D
        MOV     B,A
        MOV     A,M
        CMP     B
        RET

;--- CPY24 - copy 3 bytes [HL] -> [DE].  Clobbers A,HL,DE.
CPY24:
        MOV     A,M
        STAX    D
        INX     H
        INX     D
        MOV     A,M
        STAX    D
        INX     H
        INX     D
        MOV     A,M
        STAX    D
        RET

        CSEG
ABSCUR:  DS     3               ; origin absolute cursor offset (search start)
ABSVAL:  DS     3               ; scratch: BYTABOVE + a match's logical offset
WTARGET: DS     3               ; WFIND target offset (find-at-target mode)
WTMP:    DW     0               ; WSTEP: cursor advance target (logical)
WHIT:    DW     0               ; a match's logical offset within the window
WOVL:    DB     0               ; SRCLEN-1: straddle overlap kept across a fill
WTGSET:  DB     0               ; WFIND: 0 = find first, 1 = find abs==WTARGET
SRSVLN:  DW     0               ; saved origin line for restore-on-miss
SRSVCO:  DB     0               ; saved origin column for restore-on-miss
TRKPRV:  DS     3               ; last match with offset < ABSCUR (backward)
TRKPRVV: DB     0
TRKMAX:  DS     3               ; last match overall (backward wrap)
TRKMAXV: DB     0

        END
