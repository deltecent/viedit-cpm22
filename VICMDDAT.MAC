        PUBLIC  FDELOK, FMULTI, GAPXMSG, GCOLMSG, GMSG, GOFMSG, GPEND
        PUBLIC  GPTGT, GROMSG, GSIZMSG, HFN, HMLBOT, HMLLST
        PUBLIC  HMLTOP, INSMSG, KWSTAT, LBJ, LNCREM, MARKS
        PUBLIC  MKANY, MKDLT, MKSHT, MKTMP, MKTMP2, NEWLEN
        PUBLIC  NPUTLN, OLDLEN, OPB, OPCHAR, OPEND, OPLO
        PUBLIC  OPN, OPSTART, PDECC, PDEPTH, PDIR, PGREQ
        PUBLIC  PGSVCO, PGSVLN, PGTOP, PINCC, PSP, PTOPSV
