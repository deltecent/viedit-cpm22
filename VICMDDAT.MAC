        PUBLIC  SHLO, SHN, SHRBEG, SHRLEN, SHTMP, SHUNDOK
        PUBLIC  SHITBOT, SHITTOP, SLINE, SNOTFND, SNOTPFX, SRCBUF
        PUBLIC  SRCDIR, SRCH0, SRCLEN, STATBUF, SWRAPF
        PUBLIC  STARLEN, STARSAV, STARWP, SUBCNT, SUBCUR, SUBDELIM
        PUBLIC  SUBENTRY, SUBGLOB, SUBLAST, SUBLMAT, SUBLNS, SUBNEW
        PUBLIC  SUBOLD, SUBSM1, SUBSM2, SUBSTRT, SUBTB, SUBTOT
        PUBLIC  SUBUK, SVERR, SVWRTG, SVWRTN, UB, UCMTINS
