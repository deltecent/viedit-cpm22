;============================================================
; FILE:    VICMDDAT.MAC
; PROJECT: VIEDIT (viedit/)
; MODULE:  VICMD data: vars, messages, CMDTAB/ACTTAB dispatch tables, BLDTS
;------------------------------------------------------------
; Split out of VICMD.MAC -- see DESIGN.md / build_vi.py link order.
;============================================================
        INCLUDE VI.INC
        PUBLIC  ACTTAB, BLDTS, CMDTAB, CWTAB, DDLCNT, DGM_BLT
        PUBLIC  DGM_BUF, DGM_FREE, DGM_LNS, EBADCMD, EFNPTR, ELINE
