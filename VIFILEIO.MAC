;============================================================
; FILE:    VIFILEIO.MAC
; PROJECT: VIEDIT (viedit/)
; MODULE:  File load / save + input byte/line reader.  Verbatim (no CR xform).
;------------------------------------------------------------
; Lazy LOAD: read input through IRGETB (a buffered byte reader) into the
; window, stopping after ~2 screens of lines AT A LINE BOUNDARY (so the
; window engine always deals in whole lines) or at ^Z/EOF.  The reader is
; left positioned so the slide engine (VIWIN) and the save tail continue
; from exactly where the load stopped.
;
; STREAM SAVE (Stage A -- no slides yet): window R1+R2 then the unread input
; tail.  VIWIN's slide-aware save replaces this in Stage C.
;
; File I/O uses BDOS; the console-only-BIOS rule does not apply here.
;------------------------------------------------------------
; EXPORTS:
;   FIOPEN  INFCB -> resident buffer (oversize files refused up front)
;   FISAVE  buffer -> OUTFCB
;   INFCB OUTFCB
;   IRGETB  -> A=byte, CY=EOF    (buffered input byte reader)
;   INRDLN  HL=dst -> BC=len, CY=no-more-lines   (read one whole line)
;============================================================
        INCLUDE VI.INC

        EXTRN   BDFLD, GBLDHW, GBSTHW, GBMVTOP
        EXTRN   VMODE, GAPRSV, VMLDIN   ; VIVM: virtual-buffer engine
        EXTRN   OUTREC, RIGHTREC                 ; VIVM: scratch record counts

        PUBLIC  FIOPEN, FISAVE, INFCB, OUTFCB, IRGETB, INRDLN, IRINIT
        PUBLIC  SCRWR, SCRRD, PGBUF, ABFCB, RSFCB   ; scratch I/O for VIVM
        PUBLIC  BAKSW                            ; /B .BAK-on-save switch

        CSEG

;============================================================
; IRINIT - reset the input byte reader (INFCB already open).
;============================================================
IRINIT:
        MVI     A,RECSIZ
        STA     IRPOS           ; force a record read on first IRGETB
        XRA     A
        STA     IREOF
        RET

;============================================================
; IRGETB - next input byte.  Exit: CY clear, A=byte; or CY set at EOF.
;============================================================
IRGETB:
        LDA     IREOF
        ORA     A
        JNZ     IRG_EOF
        LDA     IRPOS
        CPI     RECSIZ
        JNZ     IRG_HAVE
        ; refill from the next record
        PUSH    B
        PUSH    H
        LXI     D,IRBUF
        MVI     C,BF_SETDMA
        CALL    BDOS
        LXI     D,INFCB
        MVI     C,BF_FREAD
        CALL    BDOS
        POP     H
        POP     B
        ORA     A
        JNZ     IRG_SEOF        ; FREAD nonzero -> EOF
        XRA     A
        STA     IRPOS
IRG_HAVE:
        LDA     IRPOS
        MOV     E,A
        MVI     D,0
        LXI     H,IRBUF
        DAD     D
        MOV     C,M             ; C = byte
        INR     A               ; A = IRPOS+1
        STA     IRPOS
        MOV     A,C
        ORA     A               ; clear CY
        RET
IRG_SEOF:
        MVI     A,1
        STA     IREOF
IRG_EOF:
        STC
        RET

;============================================================
; INRDLN - read one line into [HL].  Exit BC = byte count (incl. terminator
; if any); CY set (and BC=0) when there are no more lines.  A line ends at
; LF (kept), at ^Z/EOF, or at the LNMAX cap.
;============================================================
INRDLN:
        LXI     B,0
INRD_LP:
        PUSH    B
        PUSH    H
        CALL    IRGETB
        POP     H
        POP     B
        JC      INRD_EOF
        CPI     CPMEOF
        JZ      INRD_EOF
        MOV     M,A
        INX     H
        INX     B
        CPI     LF
        JZ      INRD_DONE       ; line complete
        ; cap check: continue while BC < LNMAX (16-bit)
        MOV     A,C
        SUI     LNMAX AND 0FFH
        MOV     A,B
        SBI     LNMAX SHR 8
        JC      INRD_LP         ; BC < LNMAX -> keep reading
INRD_DONE:
        XRA     A               ; line ended (LF or cap): CY clear
        RET
INRD_EOF:
        MOV     A,B
        ORA     C
        JZ      INRD_NONE
        XRA     A               ; have a final (unterminated) line, CY clear
        RET
INRD_NONE:
        STC
        RET

;============================================================
; FIOPEN - load INFCB fully into the (freshly GBINIT'd) buffer via IRGETB.
; RAM-only: the whole file lives resident.  Before loading, an up-front size
; gate (BDOS FSIZE = fn 35) rejects any file that would not fit in the usable
; buffer (BSIZE - MINGAP); such files are refused outright (paging to scratch
; is unusably slow on real Altair hardware).  Cursor left at the top.
;
; Exit: A = 0 loaded OK (or a new/empty file); A = 1 file too large (not loaded).
;============================================================
FIOPEN:
        XRA     A
        STA     INFCB+FCB_CR
        LXI     D,INFCB
        MVI     C,BF_FOPEN
        CALL    BDOS
        CPI     0FFH
        JZ      FIO_NEW
        ;--- up-front size gate: reject files too big to hold resident ---------
        ; FSIZE fills INFCB R0/R1/R2 with the file size in 128-byte records.
        LXI     D,INFCB
        MVI     C,BF_FSIZE
        CALL    BDOS
        LDA     INFCB+FCB_R2
        ORA     A
        JNZ     FIO_BIG         ; >= 16M records -> far too big
        LDA     INFCB+FCB_R1
        MOV     D,A
        LDA     INFCB+FCB_R0
        MOV     E,A             ; DE = file size in records
        ; cap (records) = (BSIZE - GAPRSV) >> 7.  GAPRSV is the gap kept free
        ; (= MINGAP normally; a smaller value under the /W forced-tiny window).
        MVI     A,BD_BSIZE
        CALL    GBLDHW          ; HL = BSIZE  (BDFLD preserves DE = file records)
        LDA     GAPRSV
        MOV     C,A
        LDA     GAPRSV+1
        MOV     B,A             ; BC = GAPRSV
        MOV     A,L
        SUB     C
        MOV     L,A
        MOV     A,H
        SBB     B
        MOV     H,A             ; HL = BSIZE - GAPRSV = usable bytes
        MVI     B,7             ; HL >>= 7  -> usable records
FIO_SHR:
        XRA     A               ; clear carry
        MOV     A,H
        RAR
        MOV     H,A
        MOV     A,L
        RAR
        MOV     L,A
        DCR     B
        JNZ     FIO_SHR
        ; too big if records (DE) > cap (HL):  CY set on HL - DE
        MOV     A,L
        SUB     E
        MOV     A,H
        SBB     D
        JC      FIO_TOOBIG      ; does not fit -> refuse, or go virtual under /W
        ;--- fits: load it fully resident (RAM-only, exactly as before) -------
        XRA     A
        STA     VMODE           ; RAM-only
        STA     INFCB+FCB_CR    ; FSIZE may have touched random fields; reset CR
        CALL    IRINIT
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        SHLD    FWPTR           ; write ptr = base
FIO_RDL:
        CALL    IRGETB
        JC      FIO_EOF
        CPI     CPMEOF
        JZ      FIO_EOF
        ; store byte at FWPTR
        PUSH    PSW
        LHLD    FWPTR
        POP     PSW
        MOV     M,A
        INX     H
        SHLD    FWPTR
        JMP     FIO_RDL
FIO_BIG:
        MVI     A,1             ; signal: too large to edit in RAM
        RET
FIO_EOF:
        ; GAPBG = TXEND = CSOFF = FWPTR - base
        LHLD    FWPTR
        XCHG
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        MOV     A,E
        SUB     L
        MOV     L,A
        MOV     A,D
        SBB     H
        MOV     H,A
        PUSH    H
        MVI     A,BD_GAPBG
        CALL    GBSTHW
        POP     H
        PUSH    H
        MVI     A,BD_TXEND
        CALL    GBSTHW
        POP     H
        MVI     A,BD_CSOFF
        CALL    GBSTHW
        CALL    GBMVTOP
        MVI     A,BD_MODIF
        CALL    BDFLD
        MVI     M,0
        XRA     A               ; A = 0: loaded OK
        RET
FIO_NEW:
        XRA     A               ; A = 0: new/empty file is OK
        RET

;------------------------------------------------------------
; FIO_TOOBIG - the file does not fit resident, so run it virtual: load a partial
; window and page the rest to disk.  The window is the full TPA for a real
; oversize file, or the forced-tiny /W<n> window when that test knob is set
; (VMWCAP already shrank the buffer at init in that case).  Genuinely absurd
; files (>= 16M records) never reach here -- the size gate refuses those.
; Entry: DE = file size in 128-byte records (from the size gate).
;------------------------------------------------------------
FIO_TOOBIG:
FIO_VLOAD:
        CALL    VMLDIN           ; VMODE=1 + counters; HL = records to load
        MVI     B,7
FVL_SL2:
        DAD     H
        DCR     B
        JNZ     FVL_SL2          ; HL = caprec << 7 = bytes to load
        SHLD    FVREM
        XRA     A
        STA     INFCB+FCB_CR     ; FSIZE touched random fields; reset CR
        CALL    IRINIT
        CALL    MKSCR            ; create the .$$$ / .$$B scratch files
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        SHLD    FWPTR            ; write ptr = base
FVL_RD:
        LHLD    FVREM
        MOV     A,H
        ORA     L
        JZ      FIO_EOF          ; loaded the window -> finalize like a full load
        CALL    IRGETB
        JC      FIO_EOF          ; short file (declared bigger than it read)
        PUSH    PSW
        LHLD    FWPTR
        POP     PSW
        MOV     M,A
        INX     H
        SHLD    FWPTR
        LHLD    FVREM
        DCX     H
        SHLD    FVREM
        JMP     FVL_RD

;------------------------------------------------------------
; MKSCR - build the scratch FCBs (name.$$$ and name.$$B on the edited file's
; drive) from BD_FNAME, delete any stale copies, and create fresh empty files
; so random writes have a directory slot.
;------------------------------------------------------------
MKSCR:
        LXI     D,ABFCB
        LXI     H,SCRXAB
        CALL    MKSCR1
        LXI     D,RSFCB
        LXI     H,SCRXRS
        CALL    MKSCR1
        RET
MKSCR1:                          ; DE = dst FCB, HL = &ext(3)
        XCHG                     ; HL = FCB, DE = ext ptr
        SHLD    MKFCB
        PUSH    D                ; save ext ptr
        MVI     B,FCB_SIZ
        XRA     A
MKS_Z:
        MOV     M,A
        INX     H
        DCR     B
        JNZ     MKS_Z
        ; copy drive + name8 (9 bytes) from BD_FNAME
        MVI     A,BD_FNAME
        CALL    BDFLD            ; HL = &BD_FNAME (src)
        XCHG                     ; DE = src
        LHLD    MKFCB            ; HL = dst FCB
        MVI     B,9
MKS_CP:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     MKS_CP
        ; HL now = FCB+9 (the ext slot); copy the 3-char ext
        POP     D                ; DE = ext ptr
        MVI     B,3
MKS_EX:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     MKS_EX
        ; delete stale, then make fresh
        LHLD    MKFCB
        XCHG
        MVI     C,BF_FDEL
        CALL    BDOS
        LHLD    MKFCB
        XCHG
        MVI     C,BF_FMAKE
        CALL    BDOS
        ; zero CR + random record fields
        LHLD    MKFCB
        PUSH    H
        LXI     B,FCB_CR
        DAD     B
        MVI     M,0
        POP     H
        LXI     B,FCB_R0
        DAD     B
        MVI     M,0
        INX     H
        MVI     M,0
        INX     H
        MVI     M,0
        RET

;------------------------------------------------------------
; SCRWR / SCRRD - random-write / random-read a 128-byte record between PGBUF
; and an FCB.  Entry: DE = FCB, HL = record number (0-based).  Clobbers A,BC,DE,HL.
;------------------------------------------------------------
SCRWR:
        MVI     C,BF_WRITRN
        JMP     SCRIO
SCRRD:
        MVI     C,BF_READRN
SCRIO:
        PUSH    B                ; save the BDOS function code (in C)
        SHLD    SCRREC           ; save record number
        XCHG                     ; HL = FCB
        SHLD    SCRFCB
        LXI     B,FCB_R0
        DAD     B                ; HL = &FCB.R0
        LDA     SCRREC
        MOV     M,A
        INX     H
        LDA     SCRREC+1
        MOV     M,A
        INX     H
        MVI     M,0              ; r2 = 0
        LXI     D,PGBUF
        MVI     C,BF_SETDMA
        CALL    BDOS
        LHLD    SCRFCB
        XCHG                     ; DE = FCB
        POP     B                ; C = read/write function code
        CALL    BDOS
        RET

;============================================================
; FISAVE - write the document to disk.  Three paths:
;   * RAM-only, no /B (default): straight overwrite -- window R1 ++ window R2
;     -> OUTFCB, ^Z-pad, close.  Byte-identical to the original save (unchanged).
;   * RAM-only + /B: rename-based backup save (write a fresh name.$$$, keep the
;     old file as name.BAK, promote $$$ -> the real file).
;   * virtual (VMODE=1): rename-based safe-save -- append the resident window,
;     the $$B back-scroll records, and the unread original tail to name.$$$
;     (which already holds the ABOVE records), then promote $$$ and (with /B)
;     keep the old file as .BAK.  This consumes the scratch, so a virtual save
;     is a TERMINAL operation (save then quit).
; Exit: A = 0 (saved OK).
;============================================================
FISAVE:
        LDA     VMODE
        ORA     A
        JNZ     FSV_REN         ; virtual -> rename-based safe-save
        LDA     BAKSW
        ORA     A
        JNZ     FSV_RAMB        ; RAM-only + /B -> rename-based backup save
FSV_PLAIN:
        LXI     H,OUTFCB
        SHLD    OCHAN            ; sequential writes go to OUTFCB (default channel)
        XRA     A
        STA     OUTFCB+FCB_CR
        STA     OPOS
        LXI     D,OUTFCB
        MVI     C,BF_FDEL
        CALL    BDOS
        LXI     D,OUTFCB
        MVI     C,BF_FMAKE
        CALL    BDOS
        ; window R1
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        XCHG
        MVI     A,BD_GAPBG
        CALL    GBLDHW
        CALL    WRSEG
        ; window R2
        MVI     A,BD_GAPEN
        CALL    GBLDHW
        XCHG
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        DAD     D
        PUSH    H
        MVI     A,BD_BSIZE
        CALL    GBLDHW
        XCHG
        MVI     A,BD_GAPEN
        CALL    GBLDHW
        MOV     A,E
        SUB     L
        MOV     C,A
        MOV     A,D
        SBB     H
        MOV     B,A
        POP     D
        MOV     H,B
        MOV     L,C
        CALL    WRSEG
        ; ^Z-pad the final partial record, then close
        LDA     OPOS
        ORA     A
        JZ      FSV_CL
FSV_PAD:
        MVI     A,CPMEOF
        CALL    PUTB
        LDA     OPOS
        ORA     A
        JNZ     FSV_PAD
FSV_CL:
        LXI     D,OUTFCB
        MVI     C,BF_FCLOSE
        CALL    BDOS
        LXI     D,INFCB
        MVI     C,BF_FCLOSE
        CALL    BDOS
        RET

;============================================================
; FSV_REN - virtual-mode save (rename-based, terminal).  name.$$$ already holds
; the ABOVE records (0..OUTREC-1, document order); append the resident window,
; the $$B back-scroll records (RIGHTREC-1..0 -> document order), and the unread
; original tail, then promote $$$ to the real file.
;============================================================
FSV_REN:
        CALL    CAPEXT          ; REALEXT = the real file's extension
        LHLD    OUTREC
        SHLD    APPREC          ; append after the ABOVE records in $$$
        XRA     A
        STA     APPPOS
        CALL    APPWIN          ; append window R1 ++ R2
        ; append $$B records RIGHTREC-1 .. 0 (LIFO on disk -> document order)
FSR_BLP:
        LHLD    RIGHTREC
        MOV     A,H
        ORA     L
        JZ      FSR_TAIL
        DCX     H
        SHLD    RIGHTREC        ; consume the top $$B record (save is terminal)
        LXI     D,RSFCB
        CALL    SCRRD           ; PGBUF <- $$B[RIGHTREC]
        LXI     H,PGBUF
        MVI     B,128
FSR_BF:
        MOV     A,M
        PUSH    B
        PUSH    H
        CALL    APPB
        POP     H
        POP     B
        INX     H
        DCR     B
        JNZ     FSR_BF
        JMP     FSR_BLP
FSR_TAIL:
        ; append the unread original tail via IRGETB (stops at ^Z / EOF)
        CALL    IRGETB
        JC      FSV_FIN
        CPI     CPMEOF
        JZ      FSV_FIN
        CALL    APPB
        JMP     FSR_TAIL
FSV_FIN:
        ; ^Z-pad the final partial record, then close $$$ and INFCB
        LDA     APPPOS
        ORA     A
        JZ      FSV_CLS
FSV_PL:
        MVI     A,CPMEOF
        CALL    APPB
        LDA     APPPOS
        ORA     A
        JNZ     FSV_PL
FSV_CLS:
        LXI     D,ABFCB
        MVI     C,BF_FCLOSE
        CALL    BDOS
        LXI     D,INFCB
        MVI     C,BF_FCLOSE
        CALL    BDOS
        CALL    FSVREN          ; the promote / .BAK rename dance
        XRA     A               ; A = 0: saved OK
        RET

;------------------------------------------------------------
; FSV_RAMB - RAM-only backup save (/B set): build a fresh empty name.$$$, write
; the resident buffer to it, then promote it (old file -> name.BAK).  The whole
; document is resident, so there is no $$B / tail to append.
;------------------------------------------------------------
FSV_RAMB:
        CALL    CAPEXT
        LXI     D,ABFCB
        LXI     H,SCRXAB
        CALL    MKNAM           ; ABFCB = name.$$$
        LXI     D,ABFCB
        MVI     C,BF_FDEL
        CALL    BDOS            ; delete a stale $$$
        LXI     D,ABFCB
        MVI     C,BF_FMAKE
        CALL    BDOS            ; create a fresh $$$
        LXI     H,0
        SHLD    APPREC
        XRA     A
        STA     APPPOS
        CALL    APPWIN          ; append window R1 ++ R2 (the whole document)
        JMP     FSV_FIN         ; ^Z-pad, close, promote (VMODE=0 -> no $$B step)

;------------------------------------------------------------
; APPWIN - append the resident window (R1 then R2) to name.$$$ via APPB.
;------------------------------------------------------------
APPWIN:
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        XCHG                    ; DE = base (R1 src)
        MVI     A,BD_GAPBG
        CALL    GBLDHW          ; HL = GAPBG = R1 length
        CALL    APPSEG
        MVI     A,BD_GAPEN
        CALL    GBLDHW
        XCHG                    ; DE = GAPEN
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        DAD     D               ; HL = base+GAPEN = R2 src
        PUSH    H
        MVI     A,BD_BSIZE
        CALL    GBLDHW
        XCHG                    ; DE = BSIZE
        MVI     A,BD_GAPEN
        CALL    GBLDHW          ; HL = GAPEN
        MOV     A,E
        SUB     L
        MOV     C,A
        MOV     A,D
        SBB     H
        MOV     B,A             ; BC = BSIZE - GAPEN = R2 length
        POP     D               ; DE = R2 src
        MOV     H,B
        MOV     L,C             ; HL = R2 length
        CALL    APPSEG
        RET

;------------------------------------------------------------
; APPSEG - append HL bytes from DE to name.$$$ via APPB.
;------------------------------------------------------------
APPSEG:
        MOV     A,H
        ORA     L
        RZ
        LDAX    D
        PUSH    H
        PUSH    D
        CALL    APPB
        POP     D
        POP     H
        INX     D
        DCX     H
        JMP     APPSEG

;------------------------------------------------------------
; APPB - append byte A to name.$$$: buffer into OBUF, flush a full record via a
; random write at record APPREC.  APPFL - flush OBUF (128 bytes) as record
; APPREC and advance.  Uses OBUF as the DMA buffer so PGBUF (SCRRD source in the
; $$B loop) is never disturbed.
;------------------------------------------------------------
APPB:
        PUSH    B
        PUSH    H
        MOV     C,A
        LDA     APPPOS
        MOV     E,A
        MVI     D,0
        LXI     H,OBUF
        DAD     D
        MOV     M,C
        LDA     APPPOS
        INR     A
        STA     APPPOS
        CPI     RECSIZ
        JNZ     APB_D
        CALL    APPFL
APB_D:
        POP     H
        POP     B
        RET
APPFL:
        PUSH    B
        PUSH    D
        PUSH    H
        LXI     D,OBUF
        MVI     C,BF_SETDMA
        CALL    BDOS
        LXI     H,ABFCB+FCB_R0
        LDA     APPREC
        MOV     M,A
        INX     H
        LDA     APPREC+1
        MOV     M,A
        INX     H
        MVI     M,0             ; r2 = 0
        LXI     D,ABFCB
        MVI     C,BF_WRITRN
        CALL    BDOS
        LHLD    APPREC
        INX     H
        SHLD    APPREC
        XRA     A
        STA     APPPOS
        POP     H
        POP     D
        POP     B
        RET

;------------------------------------------------------------
; CAPEXT - capture the real file's 3-char extension into REALEXT (the rename
; dance needs it as a stable pointer, and BD_FNAME is left untouched).
;------------------------------------------------------------
CAPEXT:
        MVI     A,BD_FNAME
        CALL    BDFLD
        LXI     D,9
        DAD     D               ; HL = &BD_FNAME ext
        XCHG                    ; DE = src
        LXI     H,REALEXT
        MVI     B,3
CE_L:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     CE_L
        RET

;------------------------------------------------------------
; MKNAM - build a clean FCB at DE named <BD_FNAME drive+name8>.<ext at HL>.
; Zeroes the whole FCB (incl. CR + random fields); no file operations.
;------------------------------------------------------------
MKNAM:
        SHLD    MKNEXT
        XCHG                    ; HL = dst FCB
        SHLD    MKNFCB
        MVI     B,FCB_SIZ
        XRA     A
MN_Z:
        MOV     M,A
        INX     H
        DCR     B
        JNZ     MN_Z
        MVI     A,BD_FNAME
        CALL    BDFLD
        XCHG                    ; DE = &BD_FNAME
        LHLD    MKNFCB
        MVI     B,9             ; drive + name8
MN_CN:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     MN_CN
        LHLD    MKNEXT
        XCHG                    ; DE = &ext
        LHLD    MKNFCB
        LXI     B,9
        DAD     B               ; HL = dst FCB + 9 (ext slot)
        MVI     B,3
MN_CX:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     MN_CX
        RET

;------------------------------------------------------------
; MKREN - rename <BD_FNAME name>.<old ext at HL> to <BD_FNAME name>.<new ext at
; DE>.  Builds a CP/M rename FCB (old name 0..15, new name 16..31) and calls
; BDOS fn 23.  Only the extension differs between the two names.
;------------------------------------------------------------
MKREN:
        SHLD    MKR_OE
        XCHG
        SHLD    MKR_NE          ; MKR_NE = new-ext ptr
        LXI     D,RENFCB
        LHLD    MKR_OE
        CALL    MKNAM           ; RENFCB[0..11] = name.oldext, rest zero
        MVI     A,BD_FNAME
        CALL    BDFLD
        MOV     A,M
        STA     RENFCB+16       ; new-name drive = old drive
        MVI     A,BD_FNAME
        CALL    BDFLD
        INX     H               ; HL = &BD_FNAME name8
        XCHG                    ; DE = src
        LXI     H,RENFCB+17
        MVI     B,8
MR_NN:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     MR_NN
        LHLD    MKR_NE
        XCHG                    ; DE = &new ext
        LXI     H,RENFCB+25
        MVI     B,3
MR_NX:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     MR_NX
        LXI     D,RENFCB
        MVI     C,BF_RENAME
        CALL    BDOS
        RET

;------------------------------------------------------------
; FSVREN - the promote / backup dance (shared by both rename-based saves):
;   1. delete a stale name.BAK
;   2. /B set  -> rename the old real file to name.BAK
;      /B clear -> delete the old real file
;   3. rename name.$$$ -> the real file
;   4. virtual mode -> delete name.$$B (RAM-only has none)
; REALEXT must already hold the real extension (CAPEXT).
;------------------------------------------------------------
FSVREN:
        LXI     D,BAKFCB
        LXI     H,SCRXBK
        CALL    MKNAM           ; BAKFCB = name.BAK
        LXI     D,BAKFCB
        MVI     C,BF_FDEL
        CALL    BDOS            ; delete stale .BAK
        LDA     BAKSW
        ORA     A
        JZ      FSR_DELO
        LXI     H,REALEXT
        LXI     D,SCRXBK
        CALL    MKREN           ; name.typ -> name.BAK
        JMP     FSR_PROM
FSR_DELO:
        LXI     D,BAKFCB
        LXI     H,REALEXT
        CALL    MKNAM           ; BAKFCB = name.typ
        LXI     D,BAKFCB
        MVI     C,BF_FDEL
        CALL    BDOS            ; delete the old real file
FSR_PROM:
        LXI     H,SCRXAB
        LXI     D,REALEXT
        CALL    MKREN           ; name.$$$ -> the real file
        LDA     VMODE
        ORA     A
        RZ                      ; RAM-only: no $$B to remove
        LXI     D,RSFCB
        MVI     C,BF_FDEL
        CALL    BDOS            ; remove the back-scroll scratch
        RET

;------------------------------------------------------------
; WRSEG - write HL bytes from DE via PUTB.
;------------------------------------------------------------
WRSEG:
        MOV     A,H
        ORA     L
        RZ
        LDAX    D
        PUSH    H
        PUSH    D
        CALL    PUTB
        POP     D
        POP     H
        INX     D
        DCX     H
        JMP     WRSEG

;------------------------------------------------------------
; PUTB - buffer byte A to OBUF; auto-flush a full record.
;------------------------------------------------------------
PUTB:
        PUSH    B
        PUSH    H
        MOV     C,A
        LDA     OPOS
        MOV     E,A
        MVI     D,0
        LXI     H,OBUF
        DAD     D
        MOV     M,C
        LDA     OPOS
        INR     A
        STA     OPOS
        CPI     RECSIZ
        JNZ     PUTB_D
        CALL    OFLUSH
PUTB_D:
        POP     H
        POP     B
        RET

;------------------------------------------------------------
; OFLUSH - write the OBUF record, reset OPOS.
;------------------------------------------------------------
OFLUSH:
        PUSH    B
        PUSH    D
        PUSH    H
        LXI     D,OBUF
        MVI     C,BF_SETDMA
        CALL    BDOS
        LHLD    OCHAN            ; output channel FCB (OUTFCB, or a scratch file)
        XCHG
        MVI     C,BF_FWRITE
        CALL    BDOS
        XRA     A
        STA     OPOS
        POP     H
        POP     D
        POP     B
        RET

        CSEG
OPOS:   DB      0
IRPOS:  DB      RECSIZ
IREOF:  DB      0
BAKSW:  DB      0               ; 1 = /B: keep the old file as name.BAK on save
FWPTR:  DW      0
OCHAN:  DW      OUTFCB          ; sequential-write channel FCB (PUTB/OFLUSH)
FVREM:  DW      0               ; FIO_VLOAD: bytes left to load into the window
MKFCB:  DW      0               ; MKSCR: FCB being built
SCRREC: DW      0               ; SCRWR/SCRRD: record number
SCRFCB: DW      0               ; SCRWR/SCRRD: FCB address
APPREC: DW      0               ; APPB/APPFL: next record to append to name.$$$
APPPOS: DB      0               ; APPB: bytes buffered in OBUF (0..127)
MKNFCB: DW      0               ; MKNAM: FCB being built
MKNEXT: DW      0               ; MKNAM: extension pointer
MKR_OE: DW      0               ; MKREN: old-extension pointer
MKR_NE: DW      0               ; MKREN: new-extension pointer
SCRXAB: DB      '$$$'           ; ABFCB extension (records spilled above)
SCRXRS: DB      '$$B'           ; RSFCB extension (records spilled below/right)
SCRXBK: DB      'BAK'           ; backup extension (rename-based save)
REALEXT: DS     3               ; CAPEXT: the real file's extension (rename src)
INFCB:  DS      FCB_SIZ
OUTFCB: DS      FCB_SIZ
ABFCB:  DS      FCB_SIZ         ; name.$$$  (ABOVE / output scratch)
RSFCB:  DS      FCB_SIZ         ; name.$$B  (RIGHT / below scratch)
RENFCB: DS      FCB_SIZ         ; rename FCB pair (old 0..15, new 16..31)
BAKFCB: DS      FCB_SIZ         ; name.BAK / name.typ (delete-target builder)
IRBUF:  DS      RECSIZ
OBUF:   DS      RECSIZ
PGBUF:  DS      RECSIZ          ; page-transfer buffer (spill/fill DMA)

        END
