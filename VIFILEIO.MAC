;============================================================
; FILE:    VIFILEIO.MAC
; PROJECT: VIEDIT (viedit/)
; MODULE:  File load / save + input byte/line reader.  Verbatim (no CR xform).
;------------------------------------------------------------
; Lazy LOAD: read input through IRGETB (a buffered byte reader) into the
; window, stopping after ~2 screens of lines AT A LINE BOUNDARY (so the
; window engine always deals in whole lines) or at ^Z/EOF.  The reader is
; left positioned so the slide engine (VIWIN) and the save tail continue
; from exactly where the load stopped.
;
; STREAM SAVE (Stage A -- no slides yet): window R1+R2 then the unread input
; tail.  VIWIN's slide-aware save replaces this in Stage C.
;
; File I/O uses BDOS; the console-only-BIOS rule does not apply here.
;------------------------------------------------------------
; EXPORTS:
;   FIOPEN  INFCB -> resident buffer (oversize files refused up front)
;   FISAVE  buffer -> OUTFCB
;   INFCB OUTFCB
;   IRGETB  -> A=byte, CY=EOF    (buffered input byte reader)
;   INRDLN  HL=dst -> BC=len, CY=no-more-lines   (read one whole line)
;============================================================
        INCLUDE VI.INC

        EXTRN   BDFLD, GBLDHW, GBSTHW, GBMVTOP
        EXTRN   VMODE, VMALLOW, GAPRSV, VMLDIN   ; VIVM: virtual-buffer engine

        PUBLIC  FIOPEN, FISAVE, INFCB, OUTFCB, IRGETB, INRDLN, IRINIT
        PUBLIC  SCRWR, SCRRD, PGBUF, ABFCB, RSFCB   ; scratch I/O for VIVM

        CSEG

;============================================================
; IRINIT - reset the input byte reader (INFCB already open).
;============================================================
IRINIT:
        MVI     A,RECSIZ
        STA     IRPOS           ; force a record read on first IRGETB
        XRA     A
        STA     IREOF
        RET

;============================================================
; IRGETB - next input byte.  Exit: CY clear, A=byte; or CY set at EOF.
;============================================================
IRGETB:
        LDA     IREOF
        ORA     A
        JNZ     IRG_EOF
        LDA     IRPOS
        CPI     RECSIZ
        JNZ     IRG_HAVE
        ; refill from the next record
        PUSH    B
        PUSH    H
        LXI     D,IRBUF
        MVI     C,BF_SETDMA
        CALL    BDOS
        LXI     D,INFCB
        MVI     C,BF_FREAD
        CALL    BDOS
        POP     H
        POP     B
        ORA     A
        JNZ     IRG_SEOF        ; FREAD nonzero -> EOF
        XRA     A
        STA     IRPOS
IRG_HAVE:
        LDA     IRPOS
        MOV     E,A
        MVI     D,0
        LXI     H,IRBUF
        DAD     D
        MOV     C,M             ; C = byte
        INR     A               ; A = IRPOS+1
        STA     IRPOS
        MOV     A,C
        ORA     A               ; clear CY
        RET
IRG_SEOF:
        MVI     A,1
        STA     IREOF
IRG_EOF:
        STC
        RET

;============================================================
; INRDLN - read one line into [HL].  Exit BC = byte count (incl. terminator
; if any); CY set (and BC=0) when there are no more lines.  A line ends at
; LF (kept), at ^Z/EOF, or at the LNMAX cap.
;============================================================
INRDLN:
        LXI     B,0
INRD_LP:
        PUSH    B
        PUSH    H
        CALL    IRGETB
        POP     H
        POP     B
        JC      INRD_EOF
        CPI     CPMEOF
        JZ      INRD_EOF
        MOV     M,A
        INX     H
        INX     B
        CPI     LF
        JZ      INRD_DONE       ; line complete
        ; cap check: continue while BC < LNMAX (16-bit)
        MOV     A,C
        SUI     LNMAX AND 0FFH
        MOV     A,B
        SBI     LNMAX SHR 8
        JC      INRD_LP         ; BC < LNMAX -> keep reading
INRD_DONE:
        XRA     A               ; line ended (LF or cap): CY clear
        RET
INRD_EOF:
        MOV     A,B
        ORA     C
        JZ      INRD_NONE
        XRA     A               ; have a final (unterminated) line, CY clear
        RET
INRD_NONE:
        STC
        RET

;============================================================
; FIOPEN - load INFCB fully into the (freshly GBINIT'd) buffer via IRGETB.
; RAM-only: the whole file lives resident.  Before loading, an up-front size
; gate (BDOS FSIZE = fn 35) rejects any file that would not fit in the usable
; buffer (BSIZE - MINGAP); such files are refused outright (paging to scratch
; is unusably slow on real Altair hardware).  Cursor left at the top.
;
; Exit: A = 0 loaded OK (or a new/empty file); A = 1 file too large (not loaded).
;============================================================
FIOPEN:
        XRA     A
        STA     INFCB+FCB_CR
        LXI     D,INFCB
        MVI     C,BF_FOPEN
        CALL    BDOS
        CPI     0FFH
        JZ      FIO_NEW
        ;--- up-front size gate: reject files too big to hold resident ---------
        ; FSIZE fills INFCB R0/R1/R2 with the file size in 128-byte records.
        LXI     D,INFCB
        MVI     C,BF_FSIZE
        CALL    BDOS
        LDA     INFCB+FCB_R2
        ORA     A
        JNZ     FIO_BIG         ; >= 16M records -> far too big
        LDA     INFCB+FCB_R1
        MOV     D,A
        LDA     INFCB+FCB_R0
        MOV     E,A             ; DE = file size in records
        ; cap (records) = (BSIZE - GAPRSV) >> 7.  GAPRSV is the gap kept free
        ; (= MINGAP normally; a smaller value under the /W forced-tiny window).
        MVI     A,BD_BSIZE
        CALL    GBLDHW          ; HL = BSIZE  (BDFLD preserves DE = file records)
        LDA     GAPRSV
        MOV     C,A
        LDA     GAPRSV+1
        MOV     B,A             ; BC = GAPRSV
        MOV     A,L
        SUB     C
        MOV     L,A
        MOV     A,H
        SBB     B
        MOV     H,A             ; HL = BSIZE - GAPRSV = usable bytes
        MVI     B,7             ; HL >>= 7  -> usable records
FIO_SHR:
        XRA     A               ; clear carry
        MOV     A,H
        RAR
        MOV     H,A
        MOV     A,L
        RAR
        MOV     L,A
        DCR     B
        JNZ     FIO_SHR
        ; too big if records (DE) > cap (HL):  CY set on HL - DE
        MOV     A,L
        SUB     E
        MOV     A,H
        SBB     D
        JC      FIO_TOOBIG      ; does not fit -> refuse, or go virtual under /W
        ;--- fits: load it fully resident (RAM-only, exactly as before) -------
        XRA     A
        STA     VMODE           ; RAM-only
        STA     INFCB+FCB_CR    ; FSIZE may have touched random fields; reset CR
        CALL    IRINIT
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        SHLD    FWPTR           ; write ptr = base
FIO_RDL:
        CALL    IRGETB
        JC      FIO_EOF
        CPI     CPMEOF
        JZ      FIO_EOF
        ; store byte at FWPTR
        PUSH    PSW
        LHLD    FWPTR
        POP     PSW
        MOV     M,A
        INX     H
        SHLD    FWPTR
        JMP     FIO_RDL
FIO_BIG:
        MVI     A,1             ; signal: too large to edit in RAM
        RET
FIO_EOF:
        ; GAPBG = TXEND = CSOFF = FWPTR - base
        LHLD    FWPTR
        XCHG
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        MOV     A,E
        SUB     L
        MOV     L,A
        MOV     A,D
        SBB     H
        MOV     H,A
        PUSH    H
        MVI     A,BD_GAPBG
        CALL    GBSTHW
        POP     H
        PUSH    H
        MVI     A,BD_TXEND
        CALL    GBSTHW
        POP     H
        MVI     A,BD_CSOFF
        CALL    GBSTHW
        CALL    GBMVTOP
        MVI     A,BD_MODIF
        CALL    BDFLD
        MVI     M,0
        XRA     A               ; A = 0: loaded OK
        RET
FIO_NEW:
        XRA     A               ; A = 0: new/empty file is OK
        RET

;------------------------------------------------------------
; FIO_TOOBIG - the file does not fit resident.  Refuse (A=1, as before) unless
; virtual mode is permitted (the /W switch set VMALLOW), in which case load a
; partial window and page the rest to disk.
; Entry: DE = file size in 128-byte records (from the size gate).
;------------------------------------------------------------
FIO_TOOBIG:
        LDA     VMALLOW
        ORA     A
        JZ      FIO_BIG          ; virtual not permitted -> refuse
FIO_VLOAD:
        CALL    VMLDIN           ; VMODE=1 + counters; HL = records to load
        MVI     B,7
FVL_SL2:
        DAD     H
        DCR     B
        JNZ     FVL_SL2          ; HL = caprec << 7 = bytes to load
        SHLD    FVREM
        XRA     A
        STA     INFCB+FCB_CR     ; FSIZE touched random fields; reset CR
        CALL    IRINIT
        CALL    MKSCR            ; create the .$$$ / .$$B scratch files
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        SHLD    FWPTR            ; write ptr = base
FVL_RD:
        LHLD    FVREM
        MOV     A,H
        ORA     L
        JZ      FIO_EOF          ; loaded the window -> finalize like a full load
        CALL    IRGETB
        JC      FIO_EOF          ; short file (declared bigger than it read)
        PUSH    PSW
        LHLD    FWPTR
        POP     PSW
        MOV     M,A
        INX     H
        SHLD    FWPTR
        LHLD    FVREM
        DCX     H
        SHLD    FVREM
        JMP     FVL_RD

;------------------------------------------------------------
; MKSCR - build the scratch FCBs (name.$$$ and name.$$B on the edited file's
; drive) from BD_FNAME, delete any stale copies, and create fresh empty files
; so random writes have a directory slot.
;------------------------------------------------------------
MKSCR:
        LXI     D,ABFCB
        LXI     H,SCRXAB
        CALL    MKSCR1
        LXI     D,RSFCB
        LXI     H,SCRXRS
        CALL    MKSCR1
        RET
MKSCR1:                          ; DE = dst FCB, HL = &ext(3)
        XCHG                     ; HL = FCB, DE = ext ptr
        SHLD    MKFCB
        PUSH    D                ; save ext ptr
        MVI     B,FCB_SIZ
        XRA     A
MKS_Z:
        MOV     M,A
        INX     H
        DCR     B
        JNZ     MKS_Z
        ; copy drive + name8 (9 bytes) from BD_FNAME
        MVI     A,BD_FNAME
        CALL    BDFLD            ; HL = &BD_FNAME (src)
        XCHG                     ; DE = src
        LHLD    MKFCB            ; HL = dst FCB
        MVI     B,9
MKS_CP:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     MKS_CP
        ; HL now = FCB+9 (the ext slot); copy the 3-char ext
        POP     D                ; DE = ext ptr
        MVI     B,3
MKS_EX:
        LDAX    D
        MOV     M,A
        INX     D
        INX     H
        DCR     B
        JNZ     MKS_EX
        ; delete stale, then make fresh
        LHLD    MKFCB
        XCHG
        MVI     C,BF_FDEL
        CALL    BDOS
        LHLD    MKFCB
        XCHG
        MVI     C,BF_FMAKE
        CALL    BDOS
        ; zero CR + random record fields
        LHLD    MKFCB
        PUSH    H
        LXI     B,FCB_CR
        DAD     B
        MVI     M,0
        POP     H
        LXI     B,FCB_R0
        DAD     B
        MVI     M,0
        INX     H
        MVI     M,0
        INX     H
        MVI     M,0
        RET

;------------------------------------------------------------
; SCRWR / SCRRD - random-write / random-read a 128-byte record between PGBUF
; and an FCB.  Entry: DE = FCB, HL = record number (0-based).  Clobbers A,BC,DE,HL.
;------------------------------------------------------------
SCRWR:
        MVI     C,BF_WRITRN
        JMP     SCRIO
SCRRD:
        MVI     C,BF_READRN
SCRIO:
        PUSH    B                ; save the BDOS function code (in C)
        SHLD    SCRREC           ; save record number
        XCHG                     ; HL = FCB
        SHLD    SCRFCB
        LXI     B,FCB_R0
        DAD     B                ; HL = &FCB.R0
        LDA     SCRREC
        MOV     M,A
        INX     H
        LDA     SCRREC+1
        MOV     M,A
        INX     H
        MVI     M,0              ; r2 = 0
        LXI     D,PGBUF
        MVI     C,BF_SETDMA
        CALL    BDOS
        LHLD    SCRFCB
        XCHG                     ; DE = FCB
        POP     B                ; C = read/write function code
        CALL    BDOS
        RET

;============================================================
; FISAVE - straight buffer write.  The whole file is resident (RAM-only), so
; the save is simply: window R1 ++ window R2 -> OUTFCB, then ^Z-pad the final
; partial record and close.
;============================================================
FISAVE:
        LXI     H,OUTFCB
        SHLD    OCHAN            ; sequential writes go to OUTFCB (default channel)
        XRA     A
        STA     OUTFCB+FCB_CR
        STA     OPOS
        LXI     D,OUTFCB
        MVI     C,BF_FDEL
        CALL    BDOS
        LXI     D,OUTFCB
        MVI     C,BF_FMAKE
        CALL    BDOS
        ; window R1
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        XCHG
        MVI     A,BD_GAPBG
        CALL    GBLDHW
        CALL    WRSEG
        ; window R2
        MVI     A,BD_GAPEN
        CALL    GBLDHW
        XCHG
        MVI     A,BD_BSTAR
        CALL    GBLDHW
        DAD     D
        PUSH    H
        MVI     A,BD_BSIZE
        CALL    GBLDHW
        XCHG
        MVI     A,BD_GAPEN
        CALL    GBLDHW
        MOV     A,E
        SUB     L
        MOV     C,A
        MOV     A,D
        SBB     H
        MOV     B,A
        POP     D
        MOV     H,B
        MOV     L,C
        CALL    WRSEG
        ; ^Z-pad the final partial record, then close
        LDA     OPOS
        ORA     A
        JZ      FSV_CL
FSV_PAD:
        MVI     A,CPMEOF
        CALL    PUTB
        LDA     OPOS
        ORA     A
        JNZ     FSV_PAD
FSV_CL:
        LXI     D,OUTFCB
        MVI     C,BF_FCLOSE
        CALL    BDOS
        LXI     D,INFCB
        MVI     C,BF_FCLOSE
        CALL    BDOS
        RET

;------------------------------------------------------------
; WRSEG - write HL bytes from DE via PUTB.
;------------------------------------------------------------
WRSEG:
        MOV     A,H
        ORA     L
        RZ
        LDAX    D
        PUSH    H
        PUSH    D
        CALL    PUTB
        POP     D
        POP     H
        INX     D
        DCX     H
        JMP     WRSEG

;------------------------------------------------------------
; PUTB - buffer byte A to OBUF; auto-flush a full record.
;------------------------------------------------------------
PUTB:
        PUSH    B
        PUSH    H
        MOV     C,A
        LDA     OPOS
        MOV     E,A
        MVI     D,0
        LXI     H,OBUF
        DAD     D
        MOV     M,C
        LDA     OPOS
        INR     A
        STA     OPOS
        CPI     RECSIZ
        JNZ     PUTB_D
        CALL    OFLUSH
PUTB_D:
        POP     H
        POP     B
        RET

;------------------------------------------------------------
; OFLUSH - write the OBUF record, reset OPOS.
;------------------------------------------------------------
OFLUSH:
        PUSH    B
        PUSH    D
        PUSH    H
        LXI     D,OBUF
        MVI     C,BF_SETDMA
        CALL    BDOS
        LHLD    OCHAN            ; output channel FCB (OUTFCB, or a scratch file)
        XCHG
        MVI     C,BF_FWRITE
        CALL    BDOS
        XRA     A
        STA     OPOS
        POP     H
        POP     D
        POP     B
        RET

        CSEG
OPOS:   DB      0
IRPOS:  DB      RECSIZ
IREOF:  DB      0
FWPTR:  DW      0
OCHAN:  DW      OUTFCB          ; sequential-write channel FCB (PUTB/OFLUSH)
FVREM:  DW      0               ; FIO_VLOAD: bytes left to load into the window
MKFCB:  DW      0               ; MKSCR: FCB being built
SCRREC: DW      0               ; SCRWR/SCRRD: record number
SCRFCB: DW      0               ; SCRWR/SCRRD: FCB address
SCRXAB: DB      '$$$'           ; ABFCB extension (records spilled above)
SCRXRS: DB      '$$B'           ; RSFCB extension (records spilled below/right)
INFCB:  DS      FCB_SIZ
OUTFCB: DS      FCB_SIZ
ABFCB:  DS      FCB_SIZ         ; name.$$$  (ABOVE / output scratch)
RSFCB:  DS      FCB_SIZ         ; name.$$B  (RIGHT / below scratch)
IRBUF:  DS      RECSIZ
OBUF:   DS      RECSIZ
PGBUF:  DS      RECSIZ          ; page-transfer buffer (spill/fill DMA)

        END
