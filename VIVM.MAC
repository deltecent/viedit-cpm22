;============================================================
; FILE:    VIVM.MAC
; PROJECT: VIEDIT (viedit/)
; MODULE:  Virtual buffering -- window/disk-deque engine (Phase 1).
;------------------------------------------------------------
; VIEDIT normally holds the whole file resident in one gap buffer.  When a file
; will not fit (or the /W<n> forced-tiny-window test knob is set), VIEDIT runs
; in VIRTUAL MODE: the gap buffer becomes a sliding WINDOW over the document and
; the off-window text lives on disk.  The document, in byte order, is:
;
;   [ ABOVE ]  [ window R1 | gap | window R2 ]  [ BELOW ]
;      |                                            |
;   name.$$$  (records spilled off the TOP,        name.$$B (records spilled off
;    OUTREC records, doc order)                     the BOTTOM, RIGHTREC records,
;                                                    LIFO) then the unread
;                                                    ORIGINAL tail (via IRGETB)
;
; Four primitives move 128-byte records between the window edges and disk:
;   SPILLTOP  R1 top   -> name.$$$   (frees gap; window slides down)
;   SPILLBOT  R2 bottom-> name.$$B   (frees gap; window slides up)
;   FILLFWD   below    -> R2 bottom  (brings the next record into the window)
;   REWIND    above    -> R1 top     (brings the previous record back)
; The gap is the only free pool and always sits at the cursor; records are the
; transfer unit only (lines are still found by LF scan -- records != lines).
;
; Line accounting (LINABOVE/LINBELOW) and the on-screen SPILLOK guard are
; refined in later phases; Phase 1 tracks byte/record counters and provides the
; mechanics + the /W partial-load path.  All of this is gated by VMODE: when
; VMODE=0 the RAM-only fast paths run untouched (zero regression).
;------------------------------------------------------------
; EXPORTS:
;   VMODE     DB   0=RAM-only, 1=virtual
;   VMALLOW   DB   1 => virtual mode may activate (set by the /W switch)
;   WINCAP    DW   forced window capacity (0 = use full TPA); set by /W
;   GAPRSV    DW   gap kept free in the window (load stop + spill threshold)
;   BYTABOVE BYTBELOW LINABOVE LINBELOW  DS 3   (24-bit document counters)
;   OUTREC RIGHTREC                      DW     (scratch record counts)
;   VMRSET    reset VMODE + counters to RAM-only
;   VMZERO    zero the six counters
;   VMLDIN    DE=file records -> HL=records to load; sets VMODE=1 + counters
;   SPILLTOP SPILLBOT FILLFWD REWIND SPILLOK
;============================================================
        INCLUDE VI.INC

        EXTRN   BDESC0          ; the (single) buffer descriptor (VI.MAC)
        EXTRN   GBLDHW          ; VIBUF: A=BD_xxx -> HL=field value
        EXTRN   SCRWR, SCRRD    ; VIFILEIO: random write/read PGBUF <-> FCB[rec]
        EXTRN   PGBUF           ; VIFILEIO: 128-byte page-transfer buffer
        EXTRN   ABFCB, RSFCB    ; VIFILEIO: the .$$$ / .$$B scratch FCBs
        EXTRN   IRGETB          ; VIFILEIO: buffered original-tail byte reader
        EXTRN   NEDIT           ; VISCREEN: edit-area row count (VMFILL depth)
        EXTRN   CURWLN          ; VIWIN: window-relative line of the cursor
        EXTRN   URESET          ; VICMDUND: disable undo (page op invalidates it)
        EXTRN   MKPGTOP, MKPGBOT, MKPGRW ; VICMDUND: relocate marks on a page op
        EXTRN   NAVSAV          ; VIWIN: GBMVDN/GBMVUP no-move restore target

        PUBLIC  VMODE, VMALLOW, WINCAP, GAPRSV
        PUBLIC  BYTABOVE, BYTBELOW, LINABOVE, LINBELOW, OUTREC, RIGHTREC
        PUBLIC  TAILEOF
        PUBLIC  VMRSET, VMZERO, VMLDIN
        PUBLIC  SPILLTOP, SPILLBOT, FILLFWD, REWIND, SPILLOK
        PUBLIC  FLBRK, RWBRK, VMFILL

        CSEG

;============================================================
; VMRSET - return to RAM-only: VMODE=0 and all counters cleared.  Called at a
; fresh open (before FIOPEN decides the mode).  Leaves WINCAP/GAPRSV/VMALLOW
; (the /W configuration) alone.
;============================================================
VMRSET:
        XRA     A
        STA     VMODE
        ; fall through to VMZERO

;============================================================
; VMZERO - zero the six document counters (16 bytes, contiguous).
;============================================================
VMZERO:
        LXI     H,BYTABOVE
        MVI     B,16            ; 4*DS3 + 2*DW = 16 bytes (BYTABOVE..VMCEND)
        XRA     A
VMZ_L:
        MOV     M,A
        INX     H
        DCR     B
        JNZ     VMZ_L
        RET

;============================================================
; VMLDIN - initialise virtual-mode counters for a fresh partial load.
; Entry: DE = total file size in 128-byte records.
; Exit:  HL = number of records to load into the window (caprec);
;        VMODE=1; counters zeroed except BYTBELOW = (records-caprec)*128.
; Clobbers A,BC,DE,HL.
;============================================================
VMLDIN:
        MVI     A,1
        STA     VMODE
        XRA     A
        STA     TAILEOF         ; the original tail is unread at a fresh load
        PUSH    D               ; save file records
        CALL    VMZERO
        ; caprec = (BSIZE - GAPRSV) >> 7
        MVI     A,BD_BSIZE
        CALL    GBLDHW          ; HL = BSIZE
        LDA     GAPRSV
        MOV     C,A
        LDA     GAPRSV+1
        MOV     B,A             ; BC = GAPRSV
        MOV     A,L
        SUB     C
        MOV     L,A
        MOV     A,H
        SBB     B
        MOV     H,A             ; HL = BSIZE - GAPRSV
        MVI     B,7
VLD_SHR:
        XRA     A               ; clear CY for the >>1
        MOV     A,H
        RAR
        MOV     H,A
        MOV     A,L
        RAR
        MOV     L,A
        DCR     B
        JNZ     VLD_SHR         ; HL = caprec
        POP     D               ; DE = file records
        ; belowrec = records - caprec -> BC
        MOV     A,E
        SUB     L
        MOV     C,A
        MOV     A,D
        SBB     H
        MOV     B,A             ; BC = belowrec
        PUSH    H               ; save caprec
        ; BYTBELOW = belowrec << 7
        MOV     A,C
        STA     BYTBELOW
        MOV     A,B
        STA     BYTBELOW+1
        XRA     A
        STA     BYTBELOW+2
        MVI     B,7
VLD_SL:
        XRA     A               ; clear CY (LDA below does not disturb it)
        LDA     BYTBELOW
        RAL
        STA     BYTBELOW
        LDA     BYTBELOW+1
        RAL
        STA     BYTBELOW+1
        LDA     BYTBELOW+2
        RAL
        STA     BYTBELOW+2
        DCR     B
        JNZ     VLD_SL
        POP     H               ; HL = caprec
        RET

;============================================================
; GAPLEN - HL = gap length = GAPEN - GAPBG.  Clobbers A,DE.
;============================================================
GAPLEN:
        LHLD    BDESC0+BD_GAPEN
        XCHG
        LHLD    BDESC0+BD_GAPBG
        MOV     A,E
        SUB     L
        MOV     L,A
        MOV     A,D
        SBB     H
        MOV     H,A
        RET

;============================================================
; GETR2L - HL = R2 length = BSIZE - GAPEN.  Clobbers A,DE.
;============================================================
GETR2L:
        LHLD    BDESC0+BD_BSIZE
        XCHG
        LHLD    BDESC0+BD_GAPEN
        MOV     A,E
        SUB     L
        MOV     L,A
        MOV     A,D
        SBB     H
        MOV     H,A
        RET

;============================================================
; ADD24 / SUB24 - add / subtract 16-bit DE to/from the 24-bit counter at (HL).
; Clobbers A; leaves HL at the counter's high byte.
;============================================================
ADD24:
        MOV     A,M
        ADD     E
        MOV     M,A
        INX     H
        MOV     A,M
        ADC     D
        MOV     M,A
        INX     H
        MOV     A,M
        ACI     0
        MOV     M,A
        RET
SUB24:
        MOV     A,M
        SUB     E
        MOV     M,A
        INX     H
        MOV     A,M
        SBB     D
        MOV     M,A
        INX     H
        MOV     A,M
        SBI     0
        MOV     M,A
        RET

;============================================================
; MOVDN - copy BC bytes ascending: src=(HL), dst=(DE).  For dst < src.
; MOVUP - copy BC bytes descending: src=(HL)=high end, dst=(DE)=high end.
;============================================================
MOVDN:
        MOV     A,B
        ORA     C
        RZ
MDN_L:
        MOV     A,M
        STAX    D
        INX     H
        INX     D
        DCX     B
        MOV     A,B
        ORA     C
        JNZ     MDN_L
        RET
MOVUP:
        MOV     A,B
        ORA     C
        RZ
MUP_L:
        MOV     A,M
        STAX    D
        DCX     H
        DCX     D
        DCX     B
        MOV     A,B
        ORA     C
        JNZ     MUP_L
        RET

;============================================================
; CNTLF128 - count LF bytes in PGBUF[0..128).  Exit: C = count (0..128).
; Used by SPILLTOP/REWIND to slide BD_TOPLN by the lines a record carries off
; or back onto the window top, keeping the window-relative TOPLN (and thus
; VADJ's scroll delta) consistent as the window slides.  Clobbers A,B,C,H,L.
;============================================================
CNTLF128:
        LXI     H,PGBUF
        MVI     B,128
        MVI     C,0
CLF_LP:
        MOV     A,M
        CPI     LF
        JNZ     CLF_NX
        INR     C
CLF_NX:
        INX     H
        DCR     B
        JNZ     CLF_LP
        RET

;============================================================
; SPILLTOP - evict the top 128-byte record of R1 to name.$$$, sliding R1 down
; and growing the gap.  Exit: CY clear on success; CY set if R1 < 128 (nothing
; safe to spill).
;============================================================
SPILLTOP:
        LHLD    BDESC0+BD_GAPBG ; R1 length = GAPBG
        MOV     A,H
        ORA     A
        JNZ     ST_OK
        MOV     A,L
        CPI     128
        JC      ST_NO
ST_OK:
        ; PGBUF <- base[0..128)
        LHLD    BDESC0+BD_BSTAR
        LXI     D,PGBUF
        MVI     B,128
ST_CP:
        MOV     A,M
        STAX    D
        INX     H
        INX     D
        DCR     B
        JNZ     ST_CP
        ; write PGBUF -> ABFCB at record OUTREC
        LHLD    OUTREC
        LXI     D,ABFCB
        CALL    SCRWR
        ; slide R1 down: base[128..GAPBG) -> base[0..GAPBG-128)  (ascending)
        LHLD    BDESC0+BD_BSTAR
        SHLD    VMT0            ; dst = base
        LXI     D,128
        DAD     D               ; HL = base+128 (src)
        SHLD    VMT1
        LHLD    BDESC0+BD_GAPBG
        LXI     D,0-128
        DAD     D               ; HL = GAPBG-128 = count
        MOV     B,H
        MOV     C,L
        LHLD    VMT1            ; HL = src
        XCHG                    ; DE = src
        LHLD    VMT0            ; HL = dst
        XCHG                    ; HL=src, DE=dst
        CALL    MOVDN
        ; GAPBG -= 128 ; CSOFF = GAPBG ; TXEND -= 128
        LHLD    BDESC0+BD_GAPBG
        LXI     D,0-128
        DAD     D
        SHLD    BDESC0+BD_GAPBG
        SHLD    BDESC0+BD_CSOFF
        LHLD    BDESC0+BD_TXEND
        LXI     D,0-128
        DAD     D
        SHLD    BDESC0+BD_TXEND
        ; OUTREC++ ; BYTABOVE += 128
        LHLD    OUTREC
        INX     H
        SHLD    OUTREC
        LXI     H,BYTABOVE
        LXI     D,128
        CALL    ADD24
        ; slide TOPLN down by the LFs carried off the window top (PGBUF still
        ; holds the spilled record).  Floors at 0 if the spill reached into the
        ; visible region (a Phase-1 SPILLOK will forbid that; here we clamp).
        CALL    CNTLF128         ; C = LFs in the spilled record
        MOV     A,C
        ORA     A
        JZ      ST_DONE
        LHLD    BDESC0+BD_TOPLN
        MOV     A,L
        SUB     C
        MOV     L,A
        MOV     A,H
        SBI     0
        MOV     H,A
        JNC     ST_STT
        LXI     H,0              ; clamp
ST_STT:
        SHLD    BDESC0+BD_TOPLN
        ; LINABOVE += C  (C still = LFs in the spilled record; the TOPLN slide
        ; above leaves the C register untouched).  A line left the window top for
        ; the ABOVE stream, so it is now an above-window line.
        MOV     E,C
        MVI     D,0
        LXI     H,LINABOVE
        CALL    ADD24
ST_DONE:
        ; NAVSAV holds GBMVDN/GBMVUP's pending no-move restore target as a cursor
        ; offset.  The slide shifted every offset down 128, so shift NAVSAV too --
        ; otherwise a spill triggered mid-move (e.g. GBMLNE paging the last line's
        ; end resident during a bare G) leaves NAVRST chasing a now-past-EOF offset
        ; and it spins forever.  Dead outside a move; harmless to track always.
        LHLD    NAVSAV
        LXI     D,0-128
        DAD     D
        SHLD    NAVSAV
        CALL    URESET          ; page op: pending undo is no longer safe
        CALL    MKPGTOP         ; slide marks down 128 / drop the spilled ones
        ORA     A               ; CY clear = success
        RET
ST_NO:
        STC
        RET

;============================================================
; SPILLBOT - evict the bottom 128-byte record of R2 to name.$$B, sliding R2 up
; and growing the gap.  Exit: CY clear on success; CY set if R2 < 128.
;============================================================
SPILLBOT:
        CALL    GETR2L          ; HL = R2 length
        SHLD    VMT0
        MOV     A,H
        ORA     A
        JNZ     SB_OK
        MOV     A,L
        CPI     128
        JC      SB_NO
SB_OK:
        ; PGBUF <- base[BSIZE-128..BSIZE)
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_BSIZE
        DAD     D               ; HL = base+BSIZE
        LXI     D,0-128
        DAD     D               ; HL = base+BSIZE-128 (src)
        LXI     D,PGBUF
        MVI     B,128
SB_CP:
        MOV     A,M
        STAX    D
        INX     H
        INX     D
        DCR     B
        JNZ     SB_CP
        ; write PGBUF -> RSFCB at record RIGHTREC
        LHLD    RIGHTREC
        LXI     D,RSFCB
        CALL    SCRWR
        ; slide R2 up by 128 (descending): move base[GAPEN..BSIZE-128) to
        ; base[GAPEN+128..BSIZE).  count = R2len-128.
        LHLD    VMT0
        LXI     D,0-128
        DAD     D
        MOV     B,H
        MOV     C,L             ; BC = R2len-128
        ; dst end = base+BSIZE-1
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_BSIZE
        DAD     D
        DCX     H               ; HL = base+BSIZE-1
        SHLD    VMT1            ; dst end
        LXI     D,0-128
        DAD     D               ; HL = base+BSIZE-1-128 (src end)
        XCHG                    ; DE = src end
        LHLD    VMT1            ; HL = dst end
        XCHG                    ; HL = src end, DE = dst end
        CALL    MOVUP
        ; GAPEN += 128 ; TXEND -= 128
        LHLD    BDESC0+BD_GAPEN
        LXI     D,128
        DAD     D
        SHLD    BDESC0+BD_GAPEN
        LHLD    BDESC0+BD_TXEND
        LXI     D,0-128
        DAD     D
        SHLD    BDESC0+BD_TXEND
        ; RIGHTREC++ ; BYTBELOW += 128
        LHLD    RIGHTREC
        INX     H
        SHLD    RIGHTREC
        LXI     H,BYTBELOW
        LXI     D,128
        CALL    ADD24
        ; LINBELOW += LFs in the spilled record (PGBUF still holds it -- SCRWR
        ; and the R2 slide above do not disturb it).  A line left the window
        ; bottom for the BELOW stream ($$B).
        CALL    CNTLF128         ; C = LFs
        MOV     A,C
        ORA     A
        JZ      SB_DN
        MOV     E,C
        MVI     D,0
        LXI     H,LINBELOW
        CALL    ADD24
SB_DN:
        CALL    URESET          ; page op: pending undo is no longer safe
        LHLD    BDESC0+BD_TXEND ; new window end
        CALL    MKPGBOT         ; drop marks at/past the new end (they paged out)
        ORA     A
        RET
SB_NO:
        STC
        RET

;============================================================
; FILLFWD - bring one below-record into the window bottom.  Source is the top
; of name.$$B (LIFO) if RIGHTREC>0, else the unread original tail (IRGETB,
; which may return a short final record at ^Z/EOF).  Frees gap via SPILLTOP
; first if needed.  Exit: CY clear on success; CY set if nothing is below.
;============================================================
FILLFWD:
        CALL    GAPLEN
        MOV     A,H
        ORA     A
        JNZ     FF_GAP
        MOV     A,L
        CPI     128
        JNC     FF_GAP
        CALL    SPILLTOP        ; need gap; free some from the top
        JC      FF_NO           ; cannot -> give up
FF_GAP:
        LHLD    RIGHTREC
        MOV     A,H
        ORA     L
        JZ      FF_TAIL
        ; from name.$$B: record RIGHTREC-1
        DCX     H
        SHLD    RIGHTREC
        LXI     D,RSFCB
        CALL    SCRRD
        MVI     A,128
        STA     VMK
        LXI     H,BYTBELOW
        LXI     D,128
        CALL    SUB24
        ; LINBELOW -= LFs in this $$B record (PGBUF holds it): those lines move
        ; from the BELOW stream into the window, where they are counted live.
        ; (The tail branch below reads original-file bytes never counted in
        ; LINBELOW, so it makes no LINBELOW adjustment.)
        CALL    CNTLF128         ; C = LFs
        MOV     A,C
        ORA     A
        JZ      FF_PLACE
        MOV     E,C
        MVI     D,0
        LXI     H,LINBELOW
        CALL    SUB24
        JMP     FF_PLACE
FF_TAIL:
        ; from the original tail: up to 128 bytes, stopping at ^Z / EOF
        LXI     H,PGBUF
        MVI     B,0             ; B = bytes read (K)
FF_RD:
        MOV     A,B
        CPI     128
        JZ      FF_RDN
        PUSH    B
        PUSH    H
        CALL    IRGETB
        POP     H
        POP     B
        JC      FF_EOF          ; EOF          -> original tail exhausted
        CPI     CPMEOF
        JZ      FF_EOF          ; ^Z end-of-text -> original tail exhausted
        MOV     M,A
        INX     H
        INR     B
        JMP     FF_RD
FF_EOF:
        ; The original tail is exhausted (IRGETB hit ^Z / physical EOF).  Mark it
        ; so GBNLNS can firm up the total -- and, crucially, make BYTBELOW EXACT
        ; now that no unread original bytes remain: the only text still below the
        ; window is the $$B records (RIGHTREC * 128).  VMLDIN seeded BYTBELOW from
        ; a record count that rounded the final partial record UP to 128, so up to
        ; 127 phantom padding bytes stayed counted as "below" -- bytes IRGETB will
        ; never deliver.  Left in place, that phantom makes FILLFWD keep looking
        ; below the true last line: bare G (0FFFFH target -> page down past EOF to
        ; clamp) then walks the cursor PAST line 899 and the restore/redraw spins
        ; chasing bytes that never arrive.  Recompute from $$B so it is precise.
        MVI     A,1
        STA     TAILEOF
        MOV     A,B
        STA     VMK             ; K = partial bytes read this fill (may be 0)
        CALL    FFSETBEL        ; BYTBELOW = RIGHTREC*128 (excludes the K just read)
        LDA     VMK
        ORA     A
        JZ      FF_NO           ; read nothing -> place nothing, nothing below
        JMP     FF_PLACE        ; place the K partial bytes into the window
FF_RDN:
        MOV     A,B
        STA     VMK
        ORA     A
        JZ      FF_NO           ; nothing below
        MOV     E,A
        MVI     D,0
        LXI     H,BYTBELOW
        CALL    SUB24
FF_PLACE:
        ; shift R2 down by K, then drop PGBUF[0..K) at base[BSIZE-K..BSIZE)
        CALL    GETR2L          ; HL = R2 length
        MOV     B,H
        MOV     C,L             ; BC = R2 length
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_GAPEN
        DAD     D               ; HL = base+GAPEN (src)
        SHLD    VMT0
        LDA     VMK
        MOV     E,A
        MVI     D,0
        LHLD    VMT0
        MOV     A,L
        SUB     E
        MOV     L,A
        MOV     A,H
        SBI     0
        MOV     H,A             ; HL = base+GAPEN-K (dst)
        XCHG                    ; DE = dst
        LHLD    VMT0            ; HL = src
        CALL    MOVDN
        ; PGBUF[0..K) -> base[BSIZE-K..BSIZE)
        LDA     VMK
        MOV     C,A
        MVI     B,0             ; BC = K
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_BSIZE
        DAD     D               ; HL = base+BSIZE
        LDA     VMK
        MOV     E,A
        MVI     D,0
        MOV     A,L
        SUB     E
        MOV     L,A
        MOV     A,H
        SBI     0
        MOV     H,A             ; HL = base+BSIZE-K (dst)
        XCHG                    ; DE = dst
        LXI     H,PGBUF         ; src
        CALL    MOVDN
        ; GAPEN -= K ; TXEND += K
        LDA     VMK
        MOV     E,A
        MVI     D,0
        LHLD    BDESC0+BD_GAPEN
        MOV     A,L
        SUB     E
        MOV     L,A
        MOV     A,H
        SBI     0
        MOV     H,A
        SHLD    BDESC0+BD_GAPEN
        LDA     VMK
        MOV     E,A
        MVI     D,0
        LHLD    BDESC0+BD_TXEND
        DAD     D
        SHLD    BDESC0+BD_TXEND
        CALL    URESET          ; page op: pending undo is no longer safe
        ORA     A               ; CY clear
        RET
FF_NO:
        STC
        RET

;============================================================
; FFSETBEL - BYTBELOW := RIGHTREC * 128, the exact byte count still below the
; window once the original tail is exhausted (only whole $$B records remain).
; RIGHTREC is a 16-bit record count; <<7 yields a 24-bit byte count.  Clobbers
; A, B, HL.
;============================================================
FFSETBEL:
        LHLD    RIGHTREC        ; HL = RIGHTREC (records)
        SHLD    BYTBELOW        ; low, mid  (BYTBELOW is little-endian 24-bit)
        XRA     A
        STA     BYTBELOW+2      ; high = 0
        MVI     B,7             ; * 128 == << 7
FFSB_LP:
        LDA     BYTBELOW
        ADD     A               ; << 1 ; CY = old bit 7
        STA     BYTBELOW
        LDA     BYTBELOW+1
        RAL                     ; << 1 through CY
        STA     BYTBELOW+1
        LDA     BYTBELOW+2
        RAL
        STA     BYTBELOW+2
        DCR     B
        JNZ     FFSB_LP
        RET

;============================================================
; REWIND - bring one above-record (top of name.$$$) back into the window top.
; Frees gap via SPILLBOT first if needed.  Above records are always full 128.
; Exit: CY clear on success; CY set if nothing is above.
;============================================================
REWIND:
        CALL    GAPLEN
        MOV     A,H
        ORA     A
        JNZ     RW_GAP
        MOV     A,L
        CPI     128
        JNC     RW_GAP
        CALL    SPILLBOT
        JC      RW_NO
RW_GAP:
        LHLD    OUTREC
        MOV     A,H
        ORA     L
        JZ      RW_NO
        DCX     H
        SHLD    OUTREC
        LXI     D,ABFCB
        CALL    SCRRD           ; PGBUF <- ABFCB[OUTREC]
        LXI     H,BYTABOVE
        LXI     D,128
        CALL    SUB24
        ; shift R1 up by 128 (descending): base[0..GAPBG) -> base[128..GAPBG+128)
        LHLD    BDESC0+BD_GAPBG
        MOV     B,H
        MOV     C,L             ; BC = count = GAPBG
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_GAPBG
        DAD     D
        DCX     H               ; HL = base+GAPBG-1 (src end)
        SHLD    VMT0
        LXI     D,128
        DAD     D               ; HL = base+GAPBG-1+128 (dst end)
        XCHG                    ; DE = dst end
        LHLD    VMT0            ; HL = src end
        CALL    MOVUP
        ; PGBUF[0..128) -> base[0..128)
        LXI     B,128
        LHLD    BDESC0+BD_BSTAR
        XCHG                    ; DE = base (dst)
        LXI     H,PGBUF
        CALL    MOVDN
        ; GAPBG += 128 ; CSOFF = GAPBG ; TXEND += 128
        LHLD    BDESC0+BD_GAPBG
        LXI     D,128
        DAD     D
        SHLD    BDESC0+BD_GAPBG
        SHLD    BDESC0+BD_CSOFF
        LHLD    BDESC0+BD_TXEND
        LXI     D,128
        DAD     D
        SHLD    BDESC0+BD_TXEND
        ; slide TOPLN up by the LFs brought back onto the window top (PGBUF
        ; still holds the rewound record).
        CALL    CNTLF128         ; C = LFs in the rewound record
        MOV     A,C
        ORA     A
        JZ      RW_DONE
        LHLD    BDESC0+BD_TOPLN
        MOV     E,C
        MVI     D,0
        DAD     D
        SHLD    BDESC0+BD_TOPLN
        ; LINABOVE -= C  (C still = LFs in the rewound record): a line came back
        ; from the ABOVE stream into the window top.
        MOV     E,C
        MVI     D,0
        LXI     H,LINABOVE
        CALL    SUB24
RW_DONE:
        ; 128 bytes came back on the front, shifting every offset up 128.  Track
        ; NAVSAV (GBMVDN/GBMVUP's no-move restore target) the same way, so a REWIND
        ; fired mid-move cannot leave NAVRST chasing a stale offset.
        LHLD    NAVSAV
        LXI     D,128
        DAD     D
        SHLD    NAVSAV
        CALL    URESET          ; page op: pending undo is no longer safe
        CALL    MKPGRW          ; 128 bytes came back on the front: marks += 128
        ORA     A
        RET
RW_NO:
        STC
        RET

;============================================================
; SPILLOK - how many bytes are safe to spill from an edge WITHOUT evicting text
; that is currently on screen.  SPILLTOP/SPILLBOT only ever touch the R1 head /
; R2 tail (never the cursor byte or the gap, both at the window centre), so the
; only thing to protect is VISIBLE text.  The viewport is window-relative lines
; BD_TOPLN .. BD_TOPLN+NEDIT-1.
;   A = 0 -> TOP    -> HL = bytes of R1 strictly ABOVE the top visible line
;                      (= the offset of window line BD_TOPLN's start).
;   A = 1 -> BOTTOM -> HL = bytes of R2 strictly BELOW the bottom visible line.
; GBINSRT consults this so an interactive insert prefers an off-screen edge and
; never writes visible text to disk on a stationary screen.  FILLFWD/REWIND do
; NOT use it -- their opposite-edge spill discipline must stay loose (the screen
; repaints after a page move anyway), or paging could stall.
;============================================================
SPILLOK:
        ORA     A
        JNZ     SOK_BOT
;--- TOP: offset of the start of window line BD_TOPLN within R1 ---
        LHLD    BDESC0+BD_TOPLN
        MOV     A,H
        ORA     L
        RZ                      ; TOPLN==0 -> viewport starts at offset 0 (HL=0)
        XCHG                    ; DE = TOPLN (line boundaries to pass)
        LHLD    BDESC0+BD_BSTAR
        SHLD    VMT0            ; base = offset origin
        LHLD    BDESC0+BD_GAPBG
        MOV     B,H
        MOV     C,L             ; BC = R1 length (scan bound)
        LHLD    VMT0            ; HL = base = scan ptr
SOK_TL:
        MOV     A,B
        ORA     C
        JZ      SOK_T0          ; ran out of R1 before line TOPLN (cannot happen)
        MOV     A,M
        INX     H
        DCX     B
        CPI     LF
        JNZ     SOK_TL
        DCX     D               ; passed one line boundary
        MOV     A,D
        ORA     E
        JNZ     SOK_TL
        ; HL just past the TOPLN-th LF = start of the top visible line
        XCHG                    ; DE = ptr
        LHLD    VMT0            ; HL = base
        MOV     A,E
        SUB     L
        MOV     L,A
        MOV     A,D
        SBB     H
        MOV     H,A             ; HL = ptr - base = safe head bytes
        RET
SOK_T0:
        LXI     H,0
        RET
;--- BOTTOM: R2 bytes below the bottom visible line ---
; nskip = TOPLN + NEDIT - CURWLN : LFs from the cursor's line down through the
; last visible line.  <= 0 means the cursor is at/below the viewport bottom, so
; all of R2 is off-screen (safe).  Else skip nskip LFs; the rest of R2 is safe.
SOK_BOT:
        CALL    CURWLN          ; HL = window line of the cursor
        XCHG                    ; DE = CURWLN
        LHLD    BDESC0+BD_TOPLN
        LDA     NEDIT
        MOV     C,A
        MVI     B,0
        DAD     B               ; HL = TOPLN + NEDIT
        MOV     A,L
        SUB     E
        MOV     L,A
        MOV     A,H
        SBB     D
        MOV     H,A             ; HL = nskip (signed)
        MOV     A,H
        ORA     A
        JM      SOK_BALL        ; nskip < 0 -> all R2 off-screen
        ORA     L
        JZ      SOK_BALL        ; nskip == 0 -> all R2 off-screen
        MOV     A,L
        STA     VMK2            ; nskip (1..NEDIT, fits a byte)
        CALL    GETR2L          ; HL = R2 length
        MOV     B,H
        MOV     C,L             ; BC = R2 bytes remaining
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_GAPEN
        DAD     D               ; HL = base+GAPEN = R2 head
        LDA     VMK2
        MOV     E,A             ; E = LFs to skip
SOK_BL:
        MOV     A,B
        ORA     C
        JZ      SOK_B0          ; R2 exhausted before the viewport bottom -> none
        MOV     A,M
        INX     H
        DCX     B
        CPI     LF
        JNZ     SOK_BL
        DCR     E
        JNZ     SOK_BL
        MOV     H,B             ; BC = bytes after the last skipped LF = safe
        MOV     L,C
        RET
SOK_B0:
        LXI     H,0
        RET
SOK_BALL:
        JMP     GETR2L          ; whole R2 is below the viewport -> all safe

;============================================================
; FLBRK - ensure the current line's END is resident before a forward line scan
; (GBMLNE and friends).  R2 = base[GAPEN,BSIZE) must contain an LF (the line
; terminator); if not, FILLFWD more of the document below until it does, or
; until BELOW is exhausted (the line then runs to true EOF).  The cursor stays
; logically fixed (FILLFWD preserves it).  Callers gate on VMODE.
; Clobbers A,BC,DE,HL.  Flags on return are not meaningful to callers.
;============================================================
FLBRK:
        CALL    GETR2L          ; HL = R2 length
        MOV     B,H
        MOV     C,L             ; BC = bytes to scan
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_GAPEN
        DAD     D               ; HL = base+GAPEN = R2 head
FLB_SC:
        MOV     A,B
        ORA     C
        JZ      FLB_FILL        ; scanned all of R2, no LF -> need more below
        MOV     A,M
        CPI     LF
        RZ                      ; LF resident -> line end is in the window
        INX     H
        DCX     B
        JMP     FLB_SC
FLB_FILL:
        CALL    FILLFWD
        RC                      ; nothing below -> line runs to true EOF
        JMP     FLBRK

;============================================================
; RWBRK - ensure the current line's START is resident before a backward line
; scan (GBMLNS and friends).  R1 = base[0,GAPBG) must contain an LF (the
; previous line's terminator); if not, REWIND records from ABOVE until it does,
; or until ABOVE is exhausted (the window top is then BOB = the line start).
; Scans R1 backward from the cursor so a normal short line finds its start fast.
; Cursor preserved.  Callers gate on VMODE.  Clobbers A,BC,DE,HL.
;============================================================
RWBRK:
        LHLD    BDESC0+BD_GAPBG
        MOV     B,H
        MOV     C,L             ; BC = R1 length (bytes to scan)
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_GAPBG
        DAD     D               ; HL = base+GAPBG = one past R1 end
RWB_SC:
        MOV     A,B
        ORA     C
        JZ      RWB_RW          ; no LF in R1 -> rewind more from above
        DCX     H               ; step back onto an R1 byte
        MOV     A,M
        CPI     LF
        RZ                      ; found the previous terminator -> start resident
        DCX     B
        JMP     RWB_SC
RWB_RW:
        CALL    REWIND
        RC                      ; nothing above -> window top is the line start
        JMP     RWBRK

;============================================================
; VMFILL - viewport pre-fill.  Ensure at least NEDIT lines (LFs) are resident
; BELOW the cursor in R2, so SCRDRAW / the scroll rollers (which read the
; resident buffer through the virtual reader) can paint a full screen without
; the reader hitting the window bottom.  FILLFWD until NEDIT LFs are present or
; BELOW is exhausted.  (Above-cursor screen lines are always resident -- they
; live in R1.)  RAM-only: no-op.  Called at the top of VADJ.  Clobbers A,BC,DE,HL.
;============================================================
VMFILL:
        LDA     VMODE
        ORA     A
        RZ
VMF_LP:
        CALL    GETR2L          ; HL = R2 length
        MOV     B,H
        MOV     C,L             ; BC = bytes to scan
        LHLD    BDESC0+BD_BSTAR
        XCHG
        LHLD    BDESC0+BD_GAPEN
        DAD     D               ; HL = base+GAPEN = R2 head
        MVI     E,0             ; E = LF count so far (<= NEDIT, fits a byte)
VMF_SC:
        MOV     A,B
        ORA     C
        JZ      VMF_NEED        ; scanned all of R2 -> E LFs found
        MOV     A,M
        CPI     LF
        JNZ     VMF_SN
        INR     E
        LDA     NEDIT
        CMP     E               ; NEDIT - E : done once E >= NEDIT
        JC      VMF_OK
        JZ      VMF_OK
VMF_SN:
        INX     H
        DCX     B
        JMP     VMF_SC
VMF_NEED:
        CALL    FILLFWD
        RC                      ; nothing left below -> all of BELOW is resident
        JMP     VMF_LP
VMF_OK:
        RET

        CSEG
;--- virtual-buffer configuration (persist across :e) ---
VMODE:   DB     0               ; 0 = RAM-only, 1 = virtual
VMALLOW: DB     0               ; 1 = virtual mode may activate (set by /W)
WINCAP:  DW     0               ; forced window capacity (0 = full TPA)
GAPRSV:  DW     MINGAP          ; gap kept free (load stop + spill threshold)

;--- 24-bit document counters (contiguous; zeroed by VMZERO) ---
BYTABOVE: DS    3               ; bytes above the window (in name.$$$)
BYTBELOW: DS    3               ; bytes below the window ($$B + original tail)
LINABOVE: DS    3               ; lines above the window (Phase 3)
LINBELOW: DS    3               ; lines below the window (Phase 3)
OUTREC:   DW    0               ; records written to name.$$$
RIGHTREC: DW    0               ; records held in name.$$B
VMCEND:                         ; (end marker for VMZERO)

;--- primitive scratch temps ---
VMT0:    DW     0
VMT1:    DW     0
VMK:     DB     0               ; FILLFWD: bytes brought in this fill (<=128)
VMK2:    DB     0               ; SPILLOK: LFs to skip for the bottom-visible line
TAILEOF: DB     0               ; 1 once FILLFWD has read the original tail to
                                ; EOF/^Z (no unread text remains below except
                                ; whatever has since been spilled into $$B)

        END
